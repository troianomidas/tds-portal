    public async Task OnRefreshOrderAsync()
    {
        await LoadWorkflowOrdersAsync();
    }

    async Task WorkflowOrdersCallbackAsync()
    {
        StateHasChanged();
        await JsRuntime.InvokeVoidAsync("Audio.Stop");
    }

    [JSInvokable("RefreshOrder")]
    public async Task RefreshOrder(JsGlobalInvokeModel invokeModel)
    {
        await OnRefreshOrderAsync();
        await JsRuntime.InvokeVoidAsync("Audio.Play");
    }

