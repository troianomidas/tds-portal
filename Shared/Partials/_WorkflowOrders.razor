                                            </div>
                                        </div>
                                        if (order.IsLoading)
                                        {
                                            <_LoadingButton Class="btn-sm btn-secondary w-100"/>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-secondary w-100" @onclick="async () => await UpdateOrderStatusAsync(order.Id, OrderStatusConst.Finished)">Finalizar</button>
                                        }
                                        <div class="separator separator-dashed my-4"></div>
                                    }
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<_OrderDetail Order="_orderDetail"/>

@if (_orderDispatchId > 0)
{
    <_DispatchModal OrderId="@(_orderDispatchId)" OrderNumber="@(_orderDispatchNumber)" OnSaved="async (e) => await DispatchCallbackAsync(e.Collaborator, e.OrderId)"/>
}

@code
{
    [Parameter]
    public List<OrderModel>? Orders { get; set; }

    [Parameter]
    public EventCallback<bool> OnUpdated { get; set; }

    private OrderModel? _orderDetail;
    private int _orderDispatchId;
    private int _orderDispatchNumber;

    async Task OpenOrderDetailAsync(int orderId)
    {
        if (Orders == null)
            return;

        _orderDetail = Orders.FirstOrDefault(x => x.Id == orderId);

        await JsRuntime.InvokeVoidAsync("Modal.Show", "shared_order_detail_modal");
    }

    async Task UpdateOrderStatusAsync(int orderId, int status)
    {
        if (Orders == null)
            return;

        Orders.First(x => x.Id == orderId).IsLoading = true;
        await Task.Delay(TimeSpan.FromSeconds(0.5));

        ApiResponse response = await DataRequest.SendAsync(HttpMethod.Put, "/order/status", new
        {
            Status = status,
            OrderIds = new List<int>(1) { orderId }
        });

        Orders.First(x => x.Id == orderId).IsLoading = false;

        if (!response.IsSuccessRequest)
        {
            await JsRuntime.InvokeVoidAsync("Toastr.Error", response.Error);
            return;
        }

        Orders.First(x => x.Id == orderId).Status = status;
        await OnUpdated.InvokeAsync(true);
    }

    async Task DeclineOrderAsync(int orderId, int orderNumber)
    {
        if (Orders == null)
            return;

        SweetAlertResult result = await SweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Atenção!",
            Text = $"Essa operação irá cancelar o pedido nº {orderNumber}. Deseja confirmar?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Confirmar",
            ConfirmButtonColor = "#F1416C",
            CancelButtonText = "Cancelar"
        });

        if (!string.IsNullOrEmpty(result.Value))
            await UpdateOrderStatusAsync(orderId, 9);
    }

    async Task OpenDispatchModalAsync(int orderId, int orderNumber)
    {
        _orderDispatchId = orderId;
        _orderDispatchNumber = orderNumber;
        StateHasChanged();
        await JsRuntime.InvokeVoidAsync("Modal.Show", "order_workflow_dispatch_modal");
        await JsRuntime.InvokeVoidAsync("Modal.Show", "order_workflow_dispatch_modal");
    }

    async Task DispatchCallbackAsync(CollaboratorModal? collaborator, int orderId)
    {
        if (Orders == null)
            return;

        Orders.First(x => x.Id == orderId).Status = OrderStatusConst.Delivery;
        Orders.First(x => x.Id == orderId).Collaborator = collaborator;
        StateHasChanged();
        await OnUpdated.InvokeAsync(true);
    }
}