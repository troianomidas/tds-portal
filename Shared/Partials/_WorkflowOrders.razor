@inject DataRequest DataRequest
@inject SweetAlertService SweetAlertService
@inject IJSRuntime JsRuntime

<div id="kt_app_sidebar" class="app-sidebar">
    <div class="app-sidebar-primary">
        <div class="app-sidebar-nav flex-grow-1 hover-scroll-overlay-y px-5 pt-2" id="kt_app_sidebar_primary_nav">
            <ul class="nav">
                @if (Orders != null)
                {
                    <li class="nav-item py-2">
                        <a data-bs-toggle="tab" href="#app_sidebar_pending" class="nav-link py-4 px-1 btn active">
                            <i class="ki-outline ki-time fs-1"></i>
                            @if (Orders.Count(x => x.Status == OrderStatusConst.Pending) > 0)
                            {
                                <div class="badge badge-circle badge-success position-absolute translate-middle ms-13 mt-10 h-15px w-15px fs-8">@(Orders.Count(x => x.Status == OrderStatusConst.Pending))</div>
                            }
                            <span class="pt-2 fs-9 fs-lg-7 fw-bold">Aguardando Aprovação</span>
                        </a>
                    </li>
                    <li class="nav-item py-2">
                        <a data-bs-toggle="tab" href="#app_sidebar_pending" class="nav-link py-4 px-1 btn">
                            <i class="ki-outline ki-check-circle fs-1"></i>
                            @if (Orders.Count(x => x.Status == OrderStatusConst.Confirmed) > 0)
                            {
                                <div class="badge badge-circle badge-success position-absolute translate-middle ms-13 mt-10 h-15px w-15px fs-8">@(Orders.Count(x => x.Status == OrderStatusConst.Confirmed))</div>
                            }
                            <span class="pt-2 fs-9 fs-lg-7 fw-bold">Aprovado</span>
                        </a>
                    </li>
                    <li class="nav-item py-2">
                        <a data-bs-toggle="tab" href="#app_sidebar_preparing" class="nav-link py-4 px-1 btn">
                            @if (Orders.Count(x => x.Status == OrderStatusConst.Preparation) > 0)
                            {
                                <div style="margin-bottom: -15px" class="badge badge-circle badge-success translate-middle h-15px w-15px ms-13 fs-8">@(Orders.Count(x => x.Status == OrderStatusConst.Preparation))</div>
                            }
                            <i class="ki-outline ki-watch fs-1"></i>
                            <span class="pt-2 fs-9 fs-lg-7 fw-bold">Preparando</span>
                        </a>
                    </li>
                    <li class="nav-item py-2">
                        <a data-bs-toggle="tab" href="#app_sidebar_delivery" class="nav-link py-4 px-1 btn">
                            @if (Orders.Count(x => x.Status == OrderStatusConst.Delivery) > 0)
                            {
                                <div style="margin-bottom: -15px" class="badge badge-circle badge-success translate-middle h-15px w-15px ms-13 fs-8">@(Orders.Count(x => x.Status == OrderStatusConst.Delivery))</div>
                            }
                            <i class="ki-outline ki-delivery-time fs-1"></i>
                            <span class="pt-2 fs-9 fs-lg-7 fw-bold">Entregando</span>
                        </a>
                    </li>
                    <li class="nav-item py-2">
                        <a data-bs-toggle="tab" href="#app_sidebar_delivery" class="nav-link py-4 px-1 btn">
                            @if (Orders.Count(x => x.Status == OrderStatusConst.Delivery) > 0)
                            {
                                <div style="margin-bottom: -15px" class="badge badge-circle badge-success translate-middle h-15px w-15px ms-13 fs-8">@(Orders.Count(x => x.Status == OrderStatusConst.Delivery))</div>
                            }
                            <i class="ki-outline ki-calendar-tick fs-1"></i>
                            <span class="pt-2 fs-9 fs-lg-7 fw-bold">Agendado</span>
                        </a>
                    </li>
                }

            </ul>
        </div>
    </div>
    <div class="app-sidebar-secondary">
        <div id="kt_app_sidebar_secondary_wrapper" class="scroll-y">
            <div class="tab-content pe-1 ps-1">
                <div class="tab-pane fade show active" id="app_sidebar_pending" role="tabpanel">
                    <div class="card card-reset card-p-0">
                        <div class="card-body text-center">
                            @if (Orders == null)
                            {
                                <h4 class="fw-bold text-gray-900 my-4">Carregando...</h4>
                            }
                            else
                            {
                                if (Orders.Count(x => x.Status == 1) == 0)
                                {
                                    <img src="@(StorageConst.FrontDoor)/portal/assets/media/auth/coming-soon.png" class="h-150px" alt=""/>
                                    <h4 class="fw-bold text-gray-900 my-4">Nenhum pedido pendente</h4>
                                    <span class="fw-semibold text-gray-700 mb-4 d-block">Atualização da fila de pedidos é feita em tempo real</span>
                                }
                                else
                                {
                                    foreach (OrderModel order in Orders.Where(x => x.Status == OrderStatusConst.Pending))
                                    {
                                        <div class="d-flex align-items-center mb-3">
                                            <span data-kt-element="bullet" class="bullet bullet-vertical d-flex align-items-center min-h-70px mh-100 me-4 bg-primary"></span>
                                            <div class="flex-grow-1 me-0">
                                                <div class="text-gray-800 fw-semibold fs-3 text-start d-block mb-1">
                                                    Pedido nº @(order.Number)
                                                    <span class="text-gray-600 fw-semibold fs-7 ms-2">
                                                        @(DateTimeUtils.GetFormattedDiffTime(order.CreatedAt))
                                                    </span>
                                                </div>
                                                <div class="text-gray-600 fw-semibold fs-6 text-start d-block mb-1">
                                                    @(order.GetDeliveryType())
                                                </div>
                                                <div class="text-gray-700 fw-semibold fs-6 text-start d-block">
                                                    24/05, @(order.DeliveryEstimateBeginAt.ToShortTimeString()) - @(order.DeliveryEstimateEndAt.ToShortTimeString())
                                                </div>

                                            </div>
                                            <div class="me-1">
                                                <button class="btn btn-icon btn-color-gray-500 btn-active-color-primary justify-content-end" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end" data-kt-menu-overflow="true">
                                                    <i class="ki-outline ki-dots-square fs-1 text-gray-500 me-n1"></i>
                                                </button>
                                                <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold w-150px" data-kt-menu="true" style="">
                                                    <div class="menu-item px-3">
                                                        <div class="menu-content fs-6 text-gray-900 fw-bold px-3 py-4">Ações rápidas</div>
                                                    </div>
                                                    <div class="separator mb-3 opacity-75"></div>

                                                    <div class="menu-item px-3 mb-0">
                                                        <span class="menu-link px-3" @onclick="async () => await OpenOrderDetailAsync(order.Id)">Detalhes</span>
                                                    </div>
                                                    @if (order.DeliveryTypeId == OrderDeliveryTypeConst.Delivery)
                                                    {
                                                        <div class="menu-item px-3 mb-0">
                                                            <span class="menu-link px-3" @onclick="async () => await OpenDispatchModalAsync(order.Id, order.Number)">Despachar</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="menu-item px-3 mb-0">
                                                            <span class="menu-link px-3" @onclick="async () => await UpdateOrderStatusAsync(order.Id, OrderStatusConst.Preparation)">Aceitar</span>
                                                        </div>
                                                    }
                                                    <div class="menu-item px-3 mb-0">
                                                        <span class="menu-link px-3" @onclick="async () => await DeclineOrderAsync(order.Id, order.Number)">Cancelar</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        if (order.IsLoading)
                                        {
                                            <_LoadingButton Class="btn-sm btn-secondary w-100"/>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-light-primary w-100" @onclick="async () => await UpdateOrderStatusAsync(order.Id, OrderStatusConst.Preparation)">ACEITAR</button>
                                        }
                                        <div class="separator separator-dashed my-4"></div>
                                    }
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="app_sidebar_preparing" role="tabpanel">
                    <div class="card card-reset card-p-0">
                        <div class="card-body text-center pt-0">
                            @if (Orders == null)
                            {
                                <h4 class="fw-bold text-gray-900 my-4">Carregando...</h4>
                            }
                            else
                            {
                                if (Orders.Count(x => x.Status == OrderStatusConst.Preparation) == 0)
                                {
                                    <img src="@(StorageConst.FrontDoor)/portal/assets/media/auth/coming-soon.png" class="h-150px" alt=""/>
                                    <h4 class="fw-bold text-gray-900 my-4">Nenhum pedido em preparo</h4>
                                    <span class="fw-semibold text-gray-700 mb-4 d-block">Atualização da fila de pedidos é feita em tempo real</span>
                                }
                                else
                                {
                                    foreach (OrderModel order in Orders.Where(x => x.Status == OrderStatusConst.Preparation))
                                    {
                                        <div class="d-flex align-items-center mb-3">
                                            <span data-kt-element="bullet" class="bullet bullet-vertical d-flex align-items-center min-h-70px mh-100 me-4 bg-warning"></span>
                                            <div class="flex-grow-1 me-0">
                                                <div class="text-gray-800 fw-semibold fs-3 text-start d-block mb-1">
                                                    Pedido nº @(order.Number)
                                                    <span class="text-gray-600 fw-semibold fs-7 ms-2">
                                                        @(DateTimeUtils.GetFormattedDiffTime(order.CreatedAt))
                                                    </span>
                                                </div>
                                                <div class="text-gray-600 fw-semibold fs-6 text-start d-block mb-1">
                                                    @(order.GetDeliveryType())
                                                </div>
                                                <div class="text-gray-700 fw-semibold fs-6 text-start d-block">
                                                    24/05, @(order.DeliveryEstimateBeginAt.ToShortTimeString()) - @(order.DeliveryEstimateEndAt.ToShortTimeString())
                                                </div>

                                            </div>
                                            <div class="me-1">
                                                <button class="btn btn-icon btn-color-gray-500 btn-active-color-primary justify-content-end" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end" data-kt-menu-overflow="true">
                                                    <i class="ki-outline ki-dots-square fs-1 text-gray-500 me-n1"></i>
                                                </button>
                                                <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold w-150px" data-kt-menu="true" style="">
                                                    <div class="menu-item px-3">
                                                        <div class="menu-content fs-6 text-gray-900 fw-bold px-3 py-4">Ações rápidas</div>
                                                    </div>
                                                    <div class="separator mb-3 opacity-75"></div>

                                                    <div class="menu-item px-3 mb-0">
                                                        <span class="menu-link px-3" @onclick="async () => await OpenOrderDetailAsync(order.Id)">Detalhes</span>
                                                    </div>
                                                    @if (order.DeliveryTypeId == OrderDeliveryTypeConst.Delivery)
                                                    {
                                                        <div class="menu-item px-3 mb-0">
                                                            <span class="menu-link px-3" @onclick="async () => await OpenDispatchModalAsync(order.Id, order.Number)">Despachar</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="menu-item px-3 mb-0">
                                                            <span class="menu-link px-3" @onclick="async () => await UpdateOrderStatusAsync(order.Id, OrderStatusConst.Finished)">Concluir</span>
                                                        </div>
                                                    }
                                                    <div class="menu-item px-3 mb-0">
                                                        <span class="menu-link px-3" @onclick="async () => await DeclineOrderAsync(order.Id, order.Number)">Cancelar</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        if (order.DeliveryTypeId == OrderDeliveryTypeConst.Delivery)
                                        {
                                            if (order.IsLoading)
                                            {
                                                <_LoadingButton Class="btn-sm btn-secondary w-100"/>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-light-warning w-100" @onclick="async () => await OpenDispatchModalAsync(order.Id, order.Number)">DESPACHAR</button>
                                            }
                                        }
                                        else
                                        {
                                            if (order.IsLoading)
                                            {
                                                <_LoadingButton Class="btn-sm btn-secondary w-100"/>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-light-warning w-100" @onclick="async () => await UpdateOrderStatusAsync(order.Id, OrderStatusConst.Finished)">CONCLUIR</button>
                                            }
                                        }
                                        <div class="separator separator-dashed my-4"></div>
                                    }
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="tab-pane fade" id="app_sidebar_delivery" role="tabpanel">
                    <div class="card card-reset card-p-0">
                        <div class="card-body text-center pt-0">
                            @if (Orders == null)
                            {
                                <h4 class="fw-bold text-gray-900 my-4">Carregando...</h4>
                            }
                            else
                            {
                                if (Orders.Count(x => x.Status == OrderStatusConst.Delivery) == 0)
                                {
                                    <img src="@(StorageConst.FrontDoor)/portal/assets/media/auth/coming-soon.png" class="h-150px" alt=""/>
                                    <h4 class="fw-bold text-gray-900 my-4">Nenhum pedido em entrega</h4>
                                    <span class="fw-semibold text-gray-700 mb-4 d-block">Atualização da fila de pedidos é feita em tempo real</span>
                                }
