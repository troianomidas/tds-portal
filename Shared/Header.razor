@code
{
    [Parameter]
    public StoreModel? Store { get; set; }

    [Parameter]
    public string? Username { get; set; }

    [Parameter]
    public string? StoreName { get; set; }

    [Parameter]
    public string? Avatar { get; set; }

    private bool? _isOpen = null;
    private bool? _isPrinterConnected = null;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadSettingsAsync();
            await LoadIsStoreOpenAsync();
            StateHasChanged();
        }
    }

    async Task LoadSettingsAsync()
    {
        ApiResponse response = await DataRequest.SendAsync(HttpMethod.Get, "/store/Settings");
        if (!response.IsSuccessRequest)
            await JsRuntime.InvokeVoidAsync("Toastr.Error", response.Error);

        StoreSettingsModel settings = JsonConvert.DeserializeObject<StoreSettingsModel?>(response.Json ?? string.Empty) ?? new StoreSettingsModel();
        _isPrinterConnected = settings.IsPrinterConnected;

        StateHasChanged();
    }

    async Task LoadIsStoreOpenAsync()
    {
        _isOpen = null;

        await Task.Delay(TimeSpan.FromSeconds(0.2));

        ApiResponse response = await DataRequest.SendAsync(HttpMethod.Get, "/OpeningHour");
        if (!response.IsSuccessRequest)
        {
            _isOpen = false;
            return;
        }

        var openingHour = JsonConvert.DeserializeObject<List<OpeningHourModel>>(response.Json ?? string.Empty);
        if (!openingHour?.Any() ?? false)
        {
            _isOpen = false;
            return;
        }

        if (openingHour == null)
        {
            _isOpen = false;
            return;
        }

        foreach (OpeningHourModel hour in openingHour.Where(x => x.DayOfWeek == GetDayOfWeekParsed()))
        {
            if (DateTimeUtils.Now() >= hour.DateTimeBegin() && DateTimeUtils.Now() < hour.DateTimeEnd())
            {
                _isOpen = true;
                return;
            }
        }

        _isOpen = false;
    }

    string GetDayOfWeekParsed()
    {
        return DateTimeUtils.Now().DayOfWeek.ToString();
    }
}