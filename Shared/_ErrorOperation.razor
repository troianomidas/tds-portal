@if (!string.IsNullOrEmpty(Msg))
{
    <div class="notice d-flex bg-light-danger rounded border-danger border border-dashed mb-0 p-6 mt-2">
        <i class="ki-outline ki-information-2 fs-2tx text-danger me-4"></i>
        <div class="d-flex flex-stack flex-grow-1 ">
            <div class=" fw-semibold">
                 <h4 class="text-gray-900 fw-bold mb-1">Atenção!</h4>
                <div class="fs-6 text-gray-700">
                    @(Msg).<br>
                </div>
            </div>
        </div>
    </div>
}

@code{

    [Parameter]
    public string? Msg { get; set; }
}