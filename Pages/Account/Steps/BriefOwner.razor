@inject IJSRuntime JsRuntime
@inject DataRequest DataRequest

<div class="text-center mb-11">
    <h1 class="text-gray-900 fw-bolder mb-3">
        Responsável da loja
    </h1>
    <div class="text-gray-500 fw-semibold fs-6">
        Informe os dados da pessoa que tem o nome no contrato social da empresa, seja como dona, sócia ou sócia administrativa.
    </div>
</div>

<div class="fv-row mb-6 fv-plugins-icon-container">
    <label class="form-label required">Nome completo</label>
    <input type="text" maxlength="65" class="form-control form-control-lg" @bind="@(Model.OwnerName)" @onfocusout="ToUpperCase">
    @if (_fieldError == "ownerName")
    {
        <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback mt-2">@(_msgError)</div>
    }
</div>

<div class="fv-row mb-6 fv-plugins-icon-container">
    <label class="form-label required">CPF do responsável legal</label>
    <input type="text" class="form-control form-control-lg document" @bind="@(Model.OwnerDocument)" placeholder="000.000.000-00">
    @if (_fieldError == "ownerDocument")
    {
        <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback mt-2">@(_msgError)</div>
    }
</div>

<div class="d-flex flex-stack pt-5 mb-8">
    <div class="mr-2">
        <button type="button" class="btn btn-light-success me-3" @onclick="async () => await OnBack.InvokeAsync(true)">
            <i class="ki-outline ki-arrow-left fs-4 me-1"></i> Voltar
        </button>
    </div>

    <div>
        @if (_loading)
        {
            <_LoadingButton Class="btn-success"/>
        }
        else
        {
            <button type="button" class="btn btn-success" @onclick="async () => await SaveAsync()">
                Continuar
                <i class="ki-outline ki-arrow-right fs-4 ms-1"></i>
            </button>
        }
    </div>
</div>

@code
{
    [Parameter]
    public required StoreModel Model { get; set; }

    [Parameter]
    public EventCallback<bool> OnContinue { get; set; }

    [Parameter]
    public EventCallback<bool> OnBack { get; set; }

    private bool _loading;
    private string? _msgError;
    private string? _fieldError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("InputMask.Document");
        }
    }

    async Task SaveAsync()
    {
        _msgError = null;
        _fieldError = null;
        _loading = true;
        await Task.Delay(TimeSpan.FromSeconds(0.5));

        try
        {
            Validate();
            
            ApiResponse response = await DataRequest.SendAsync(HttpMethod.Get, $"/Account/DocumentExists?document={Model.OwnerDocument}");
            var alreadyExists = Convert.ToBoolean(response.Json ?? "false");
            if (alreadyExists)
                throw new InvalidOperationException("Este documento já está sendo utilizado por outro cliente.", new Exception("ownerDocument"));
        }
        catch (Exception e)
        {
            _msgError = e.Message;
            _fieldError = e.InnerException?.Message;
            await JsRuntime.InvokeVoidAsync("Toastr.Error", _msgError);
            return;
        }
        finally
        {
            _loading = false;
        }

        await OnContinue.InvokeAsync(true);
    }

    void ToUpperCase()
    {
        if (string.IsNullOrEmpty(Model.OwnerName))
            return;

        Model.OwnerName = CustomerUtils.FirstCharToUpper(Model.OwnerName);
    }

    void Validate()
    {
        if (string.IsNullOrEmpty(Model.OwnerName))
            throw new InvalidOperationException("Preencha o nome completo.", new Exception("ownerName"));

        if (Model.OwnerName.Split(" ").Length < 2)
            throw new InvalidOperationException("Preencha o nome completo.", new Exception("ownerName"));

        if (Model.OwnerName.Length > 65)
            throw new InvalidOperationException("O nome completo deve ter no máximo 65 caracteres.", new Exception("ownerName"));

        if (string.IsNullOrEmpty(Model.OwnerDocument))
            throw new InvalidOperationException("Preencha CPF do responsável legal.", new Exception("ownerDocument"));

        if (!DocumentUtils.IsCpfValid(Model.OwnerDocument))
            throw new InvalidOperationException("Informe um CPF válido.", new Exception("ownerDocument"));
    }
}