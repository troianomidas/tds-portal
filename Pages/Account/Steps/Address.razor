@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JsRuntime

<div class="text-center mb-11">
    <h1 class="text-gray-900 fw-bolder mb-3">
        Endereço da loja
    </h1>
    <div class="text-gray-500 fw-semibold fs-6">
        Preencha as informações de endereço da sua loja.
    </div>
</div>
<div class="fv-row mb-6 fv-plugins-icon-container">
    <label class="form-label required">CEP</label>
    <div class="input-group">
        <input type="text" class="form-control form-control-lg zipcode" value="@(Model.Address!.Zipcode)" placeholder="00000-000" @oninput="async (e) => await LoadAddressByZipcode(e.Value?.ToString())">
        @if (_loading)
        {
            <span class="input-group-text border-0">
                <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
            </span>
        }
        </div>
    <a href="https://buscacepinter.correios.com.br/app/endereco/index.php" target="_blank" class="d-block link-primary fw-semibold mt-2">Descubra seu CEP</a>
    @if (_fieldError == "zipcode")
    {
        <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback mt-2">@(_msgError)</div>
    }
</div>
<div class="fv-row mb-6 fv-plugins-icon-container">
    <div class="row">
        <div class="col-6">
            <label class="form-label">Estado</label>
            <input type="text" readonly="readonly" disabled="disabled" class="form-control form-control-lg" value="@(Model.Address!.State)">
        </div>
        <div class="col-6">
            <label class="form-label">Cidade</label>
            <input type="text" readonly="readonly"disabled="disabled" class="form-control form-control-lg" value="@(Model.Address!.City)">
        </div>
    </div>

</div>
<div class="fv-row mb-6 fv-plugins-icon-container">
    <label class="form-label required">Bairro</label>
    <input type="text" maxlength="45" class="form-control form-control-lg" @bind="@(Model.Address.Neighborhood)">
    @if (_fieldError == "neighborhood")
    {
        <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback mt-2">@(_msgError)</div>
    }
</div>
<div class="fv-row mb-6 fv-plugins-icon-container">
    <label class="form-label required">Logradouro</label>
    <input type="text" maxlength="100" class="form-control form-control-lg" @bind="@(Model.Address.Line1)">
    @if (_fieldError == "line1")
    {
        <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback mt-2">@(_msgError)</div>
    }
</div>
<div class="fv-row mb-8 fv-plugins-icon-container">
    <div class="row">
        <div class="col-6">
            <label class="form-label required">Número</label>
            <input type="text" maxlength="45" class="form-control form-control-lg" @bind="@(Model.Address.Number)">
            @if (_fieldError == "number")
            {
                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback mt-2">@(_msgError)</div>
            }
        </div>
        <div class="col-6">
            <label class="form-label">Complemento (Opcional)</label>
            <input type="text" maxlength="45" class="form-control form-control-lg" placeholder="Apartamento ou bloco" value="@(Model.Address.Line2)">
            @if (_fieldError == "line2")
            {
                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback mt-2">@(_msgError)</div>
            }
        </div>
    </div>
</div>

<div class="d-flex flex-stack pt-5 mb-8">
    <div class="mr-2">
        <button type="button" class="btn btn-light-success me-3" @onclick="async () => await OnBack.InvokeAsync(true)">
            <i class="ki-outline ki-arrow-left fs-4 me-1"></i> Voltar
        </button>
    </div>

    <div>
        @if (_loading)
        {
            <_LoadingButton Class="btn-success"/>
        }
        else
        {
            <button type="button" class="btn btn-success" @onclick="async () => await SaveAsync()">
                Continuar
                <i class="ki-outline ki-arrow-right fs-4 ms-1"></i>
            </button>
        }
    </div>
</div>

@code
{
    [Parameter]
    public required StoreModel Model { get; set; }

    [Parameter]
    public EventCallback<bool> OnContinue { get; set; }

    [Parameter]
    public EventCallback<bool> OnBack { get; set; }

    private bool _loading;
    private string? _msgError;
    private string? _fieldError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("InputMask.Zipcode");
        }
    }

    async Task SaveAsync()
    {
        _msgError = null;
        _fieldError = null;
        _loading = true;
        await Task.Delay(TimeSpan.FromSeconds(0.5));

        try
        {
            Validate();
        }
        catch (Exception e)
        {
            _msgError = e.Message;
            _fieldError = e.InnerException?.Message;
            await JsRuntime.InvokeVoidAsync("Toastr.Error", _msgError);
            return;
        }
        finally
        {
            _loading = false;
        }

        await OnContinue.InvokeAsync(true);
    }

    async Task LoadAddressByZipcode(string? zipcode)
    {
        if (zipcode?.Length < 9 || Model.Address == null)
        {
            if (Model.Address == null)
                return;
            
            Model.Address.City = null;
            Model.Address.State = null;
            Model.Address.Line1 = null;
            Model.Address.Neighborhood = null;

            return;
        }

        Model.Address.Zipcode = zipcode;
        _loading = true;

        try
        {
            HttpClient client = HttpClientFactory.CreateClient();
            var address = await client.GetFromJsonAsync<ViacepAddress>($"https://viacep.com.br/ws/{zipcode}/json");

            if (address == null)
                return;

            Model.Address.City = address.City;
            Model.Address.State = address.State;
            Model.Address.Line1 = address.Line1;
            Model.Address.Neighborhood = address.Neighborhood;
        }
        catch (Exception e)
        {
            await JsRuntime.InvokeVoidAsync("Toastr.Error", e.Message);
        }
        finally
        {
            _loading = false;
        }
    }
    
    void Validate()
    {
        if (Model.Address == null)
            return;
        
        if (string.IsNullOrEmpty(Model.Address.Zipcode))
            throw new InvalidOperationException("Preencha o CEP.", new Exception("zipcode"));
        
        if(string.IsNullOrEmpty(Model.Address.City) || string.IsNullOrEmpty(Model.Address.State))
            throw new InvalidOperationException("Preencha corretamente o CEP para buscar o endereço.", new Exception("zipcode"));
        
        if (string.IsNullOrEmpty(Model.Address.Neighborhood))
            throw new InvalidOperationException("Preencha o bairro.", new Exception("neighborhood"));
        
        if (!string.IsNullOrEmpty(Model.Address.Neighborhood) && Model.Address.Neighborhood.Length > 45)
            throw new InvalidOperationException("O bairro deve ter no máximo 45 caracteres.", new Exception("neighborhood"));
        
        if (string.IsNullOrEmpty(Model.Address.Line1))
            throw new InvalidOperationException("Preencha o endereço.", new Exception("line1"));

        if (Model.Address.Line1.Length is < 6 or > 100)
            throw new InvalidOperationException("O endereço deve ter entre 6 e 100 caracteres.", new Exception("line1"));
        
        if (string.IsNullOrEmpty(Model.Address.Number))
            throw new InvalidOperationException("Preencha o número do endereço.", new Exception("number"));

        if (!string.IsNullOrEmpty(Model.Address.Number) && Model.Address.Number.Length > 45)
            throw new InvalidOperationException("O número do endereço deve ter no máximo 45 caracteres.", new Exception("number"));
        
        if (!string.IsNullOrEmpty(Model.Address.Line2) && Model.Address.Line2.Length > 45)
            throw new InvalidOperationException("O complemento ter no máximo 45 caracteres.", new Exception("line2"));
    }
}