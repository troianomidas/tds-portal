        // }
        //
        // _customers = await Sender.Send(new GetAllCustomersQuery { CustomerType =CustomerTypeEnum.Customer, Limit = _limit, Page = _page });
    }

    async Task OnSearchChangeAsync(object? filter)
    {
        _loading = true;

        await Task.Delay(TimeSpan.FromSeconds(0.5));

        _nameOrPhone = filter?.ToString();
        
        await LoadPaginateAsync();

        _loading = false;
    }

    async Task PaginateAsync(int page, int totalPage = 0)
    {
        _loading = true;

        await Task.Delay(TimeSpan.FromSeconds(0.5));

        // if (_customers != null)
        //     _page += page;

        if (_page < 1)
            _page = 1;

        if (totalPage > 0)
            _page = totalPage;

        await LoadPaginateAsync();

        _loading = false;
        StateHasChanged();
    }

    async Task LoadPaginateAsync()
    {
        // _customers = await Sender.Send(new GetCustomersByNameOrPhoneQuery { NameOrPhone = _nameOrPhone, CustomerType = CustomerTypeEnum.Customer, Limit = _limit, Page = _page });
    }
}