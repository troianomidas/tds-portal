                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <a class="text-gray-900 fs-6"></a>
                                    </td>
                                    <td>
                                        <a class="text-gray-900 fs-6"></a>
                                    </td>
                                    <td>
                                        <a class="text-gray-900 fs-6">Valor recebido</a>
                                    </td>
                                    <td>
                                        <a class="text-gray-900 fs-6">-</a>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <a class="text-gray-900 fs-6"></a>
                                    </td>
                                    <td>
                                        <a class="text-gray-900 fs-6"></a>
                                    </td>
                                    <td>
                                        <a class="text-gray-900 fs-6">Valor retido</a>
                                    </td>
                                    <td>
                                        <a class="text-gray-900 fs-6">-</a>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <a class="text-gray-900 fs-6"></a>
                                    </td>
                                    <td>
                                        <a class="text-gray-900 fs-6"></a>
                                    </td>
                                    <td>
                                        <a class="text-gray-900 fw-bold fs-6">Valor a receber</a>
                                    </td>
                                    <td>
                                        <a class="text-gray-900 fs-6">-</a>
                                    </td>
                                </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card card-flush overflow-hidden h-lg-100 mb-7">
                    <div class="card-header pt-5">
                        <h3 class="card-title align-items-start flex-column">
                            <span class="card-label fw-bold text-dark">Histórico de faturamento</span>
                            <span class="text-gray-400 mt-1 fw-semibold fs-6">@_dashboardFinancialModel.TotalOrders pedidos processados no mês de @_filterDate.ToString("MMMM")</span>
                        </h3>
                    </div>
                    <div class="card-body d-flex align-items-end p-0">
                        <div id="kt_charts_widget_28" class="min-h-auto w-100 ps-4 pe-6" style="height: 300px; min-height: 315px;">
                        </div>
                    </div>
                </div>
            }
            @if (_dashboardFinancialModel == null)
            {
                <div class="card">
                    <div class="card-body">
                        <div class="card-px text-center pt-15 pb-15">
                            <h2 class="fs-2x fw-bold mb-0">Parece que sua loja não recebeu pedidos no mês de @(_filterDate.Date.ToString("MMMM"))</h2>
                            <p class="text-gray-400 fs-4 fw-semibold py-7">
                                Fique tranquilo! Assim que sua loja receber os pedidos, realizaremos a coleta dos dados e os apresentaremos aqui
                            </p>
                        </div>
                        <div class="text-center pb-15 px-5">
                            <img src="https://delivery3-dzgdgkbdccbefha5.z03.azurefd.net/portal/assets/media/illustrations/4.png" alt="" class="mw-100 h-200px h-sm-325px">
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>


@code
{
    private DashboardFinancialModel? _dashboardFinancialModel;

    private DateTime _filterDate = DateTimeUtils.Now();
    private bool _isLoading;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("GLOBAL.SetDotnetReference", DotNetObjectReference.Create(this));
            await JsRuntime.InvokeVoidAsync("DatePicker.Financial", "input.flatpickr");

            _dashboardFinancialModel = null;

            await LoadOrderModelAsync();

            StateHasChanged();
        }
        else
        {
            if (_dashboardFinancialModel != null)
                await JsRuntime.InvokeVoidAsync("ChartJs.LineChart", _dashboardFinancialModel!.HistoryProfitsPerDate, _dashboardFinancialModel.HistoryDates);
        }
    }

    async Task LoadOrderModelAsync()
    {
        _isLoading = true;
        await Task.Delay(TimeSpan.FromSeconds(0.2));

        ApiResponse response = await DataRequest.SendAsync(HttpMethod.Get, $"/Financial?dateFilterDate={_filterDate.Date:yyyy-MM-dd}");
        _isLoading = false;
        if (!response.IsSuccessRequest || response.StatusCode == 204)
            _dashboardFinancialModel = null;
        else
        {
            _dashboardFinancialModel = JsonConvert.DeserializeObject<DashboardFinancialModel>(response.Json ?? string.Empty);
            await JsRuntime.InvokeVoidAsync("ChartJs.LineChart", _dashboardFinancialModel!.HistoryProfitsPerDate, _dashboardFinancialModel.HistoryDates);
        }

        StateHasChanged();
    }

    [JSInvokable("SetDateFilterFromDatePicker")]
    public async Task SetDateFromDatePicker(DatePicker datePicker)
    {
        if (datePicker.Input == "filterDate")
            _filterDate = DateTime.Parse(datePicker.DateStr ?? DateTimeUtils.Now().Date.ToString("MMMM de yyyy"));

        await LoadOrderModelAsync();

        StateHasChanged();
    }

    public class DatePicker
    {
        public string? Input { get; set; }
        public string? DateStr { get; set; }
    }
}