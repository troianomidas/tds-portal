                                                <i class="ki-outline ki-information fs-7 hover text-muted text-gray-900"></i>
                                            </span>
                                        </div>
                                        <div class="fs-4 fw-bold">@CurrencyUtils.MoneyFormat(_dashboardFinancialModel.GrossValue)</div>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex flex-column py-2" style="padding-right: 2rem">
                                <div class="d-flex align-items-center">
                                    <div>
                                        <div class="fs-6 fw-semibold text-gray-500">
                                            Valor para repasse
                                            <span class="ms-1 text-muted text-gray-900" data-bs-toggle="tooltip" aria-label="É a soma dos valores de todos os pedidos pagos em determinado mês." data-bs-original-title="É a soma dos valores de todos os pedidos pagos em determinado mês." data-kt-indicator="1">
                                                <i class="ki-outline ki-information fs-7 hover text-muted text-gray-900"></i>
                                            </span>
                                        </div>
                                        <div class="fs-4 fw-bold">@CurrencyUtils.MoneyFormat(0)</div>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex flex-column py-2" style="padding-right: 2rem">
                                <div class="d-flex align-items-center">
                                    <div>
                                        <div class="fs-6 fw-semibold text-gray-500">
                                            Valor recebido
                                            <span class="ms-1 text-muted text-gray-900" data-bs-toggle="tooltip" aria-label="É a soma dos valores de todos os pedidos pagos em determinado mês." data-bs-original-title="É a soma dos valores de todos os pedidos pagos em determinado mês." data-kt-indicator="1">
                                                <i class="ki-outline ki-information fs-7 hover text-muted text-gray-900"></i>
                                            </span>
                                        </div>
                                        <div class="fs-4 fw-bold">@CurrencyUtils.MoneyFormat(0)</div>
                                    </div>
                                </div>
                            </div>
