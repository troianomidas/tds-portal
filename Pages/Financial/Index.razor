@page "/financial"
@using WebApp.Constants

@attribute [Authorize(Policy = Policies.SubscriptionActive)]

@inject IJSRuntime JsRuntime
@inject DataRequest DataRequest

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar mt-8">
        <div id="kt_app_toolbar_container" class="app-container container-xxl d-flex flex-stack">
            <div class="page-title d-flex flex-column justify-content-center me-3 ">
                <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">
                    Financeiro
                </h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-6 my-0 pt-1">
                    <li class="breadcrumb-item text-muted">
                        <a class="text-muted text-hover-success">
                            Visão geral dos valores recebidos pela sua loja
                        </a>
                    </li>
                </ul>
            </div>
            <div class="d-flex align-items-center gap-4">
                <div class="d-flex mb-0 mt-1 align-items-center cursor-pointer">
                    <span class="ki-outline ki-calendar-2 text-success me-2 cursor-pointer" onclick="$('input.flatpickr').click()"></span>
                    <input type="text" class="flatpickr theme-light-bg-transparent text-success cursor-pointer text-center w-100" name="filterDate"/>
                     @if (_isLoading)
                        {
                            <span class="ki-outline spinner-border spinner-border-sm align-middle ms-2"></span>
                        }
                        else
                        {
                            <span class="ki-outline ki-down text-success cursor-pointer" onclick="$('input.flatpickr').click()"></span>    
                        }
                </div>
            </div>
        </div>
    </div>

