@page "/tickets/create"
@using WebApp.Models.Tickets

@inject DataRequest DataRequest
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager

@attribute [Authorize]

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar mt-8">
        <div id="kt_app_toolbar_container" class="app-container container-xxl d-flex flex-stack">
            <div class="page-title d-flex flex-column justify-content-center me-3">
                <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">
                    Criação Ticket
                </h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-6 my-0 pt-1">
                    <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-6 my-0 pt-1">
                        <li class="breadcrumb-item text-muted">
                            <a href="/support" class="text-muted text-hover-success">
                                Suporte
                            </a>
                        </li>
                        <li class="breadcrumb-item">
                            <span class="bullet bg-gray-400 w-5px h-2px"></span>
                        </li>
                        <li class="breadcrumb-item text-muted">
                            <a href="/tickets" class="text-muted text-hover-success">
                                Meus Tickets
                            </a>
                        </li>
                        <li class="breadcrumb-item">
                            <span class="bullet bg-gray-400 w-5px h-2px"></span>
                        </li>
                        <li class="breadcrumb-item text-muted">
                            <a class="text-success">
                                Criar Ticket
                            </a>
                        </li>
                    </ul>
                </ul>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="/tickets" class="btn btn-sm fw-semibold btn-success">
                    Voltar
                </a>
            </div>
        </div>
    </div>

    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="app-container container-xxl">
            <div class="card">
                <div class="card-body p-lg-15">
                    <div class="modal-body scroll-y px-10 px-lg-15 pt-0 pb-15" style="margin-bottom: -60px;">
                        <form id="kt_modal_new_ticket_form" class="form fv-plugins-bootstrap5 fv-plugins-framework" action="#">
                            <div class="mb-13 text-center">
                                <h1 class="mb-3">Criar Ticket</h1>
                                <div class="text-gray-400 fw-semibold fs-5">
                                    Se precisar de mais informações acesse <a href="/support" class="fw-bold link-success">Suporte</a>.
                                </div>
                            </div>
                            <div class="d-flex flex-column mb-8 fv-row fv-plugins-icon-container">
                                <label class="d-flex align-items-center fs-6 fw-semibold mb-2 form-label">
                                    <span class="required">Título</span>
                                    <span class="ms-2" data-bs-toggle="tooltip" aria-label="Ecolha um título para o seu ticket." data-bs-original-title="Ecolha um título para o seu ticket." data-kt-initialized="1">
                                        <i class="ki-outline ki-information fs-7 hover"></i>
                                    </span>
                                </label>
                                <input type="text" class="form-control form-control-solid" placeholder="Insira um título para seu ticket" @bind="_ticket.Title">
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
                            </div>
                            <div class="d-flex flex-column mb-8 fv-row fv-plugins-icon-container">
                                <label class="col-xl-3 col-lg-3 col-form-label text-sm-left text-lg-right">Descrição</label>
                                <textarea @bind="_ticket.Body" class="form-control form-control-solid"></textarea>
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
                            </div>
                            <div class="d-flex flex-column mb-8 fv-row fv-plugins-icon-container">
                                <label class="d-flex align-items-center fs-6 fw-semibold mb-2 form-label">Imagem descritiva
                                    <span class="ms-1 text-muted text-gray-900" data-bs-toggle="tooltip" aria-label="Inclua uma imagem no seu ticket para que possamos entender melhor que você quer dizer. Este campo não é obrigatório." data-bs-original-title="Inclua uma imagem no seu ticket para que possamos entender melhor que você quer dizer. Este campo não é obrigatório." data-kt-indicator="1">
                                        <i class="ki-outline ki-information fs-7 hover text-muted text-gray-900"></i>
                                    </span>
                                </label>
                                <div class="card card-flush py-2">
                                    <div class="card-body p-0">
                                        <_InputImage Thumbnail="@(_ticket.ImageUrl)" OnUploaded="imageUrl => _ticket.ImageUrl = imageUrl" OnRemove="s => _ticket.ImageUrl = null"/>
                                        <div class="text-muted fs-7">Somente arquivos de imagem *.png, *.jpg e *.jpeg são aceitos.</div>
                                    </div>
                                </div>
                            </div>
                            <div class="mb-15 fv-row fv-plugins-icon-container">
                                <div class="d-flex flex-stack">
                                    <div class="fw-semibold me-5">
                                        <label class="fs-6">Notificações</label>
                                        <div class="fs-7 text-gray-400">As notificações serão enviadas no email</div>
                                    </div>
                                </div>
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
                            </div>
                            <div class="text-center">
                                <button type="button" class="btn btn-light me-3" @onclick="async () => await CancelAndCloseAsync()">
                                    Cancelar
                                </button>
                                <button type="button" class="btn btn-success" @onclick="async () => await CreateTicketAsync()">
                                    <span class="indicator-label">
                                        Enviar
                                    </span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private TicketModel _ticket { get; set; }

    private bool _isLoading;

    protected override async Task OnInitializedAsync()
    {
        _ticket = new TicketModel();
    }

    async Task CreateTicketAsync()
    {
        _isLoading = true;
        await Task.Delay(TimeSpan.FromSeconds(0.5));

        ApiResponse response = await DataRequest.SendAsync(HttpMethod.Post, "/Ticket", new { _ticket.Title, _ticket.Body, _ticket.ImageUrl });
        _isLoading = false;
        if (!response.IsSuccessRequest)
        {
            await JsRuntime.InvokeVoidAsync("Toastr.Warning", response.Error);
            return;
        }

        StateHasChanged();

        NavigationManager.NavigateTo("/tickets");
        
        await JsRuntime.InvokeVoidAsync("Toastr.Success", "Ticket criado com sucesso.");
    }

    async Task CancelAndCloseAsync()
    {
       NavigationManager.NavigateTo("/tickets");
    }
}