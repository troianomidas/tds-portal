@inject IJSRuntime JsRuntime

<div class="modal fade" id="order_discount_modal" data-bs-backdrop="static" tabindex="-1" role="dialog" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered mw-750px">
        <div class="modal-content">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <i class="ki-outline ki-cross fs-1"></i>
                </div>
            </div>
            <div class="modal-body scroll-y mx-5 pt-0">
                <div class="mb-10 text-center">
                    <h1 class="mb-3">Desconto</h1>
                    <div class="text-muted fw-semibold fs-5">Você pode aplicar o desconto para o pedido usando porcentagem ou valor fixo.</div>
                </div>
                <div class="row row-cols-1 row-cols-md-3 row-cols-lg-1 row-cols-xl-3 g-9" data-kt-buttons="true" data-kt-buttons-target="[data-kt-button='true']" data-kt-initialized="1">
                    <div class="col">
                        <label class="btn btn-outline btn-outline-dashed btn-active-light-primary d-flex text-start p-6 @(_discountType == 1 ? "active" : "")" data-kt-button="true">
                            <span class="form-check form-check-custom form-check-solid form-check-sm align-items-start mt-1">
                                <input class="form-check-input" type="radio" name="discount_option" checked="@(_discountType == 1)" value="1" @onchange='() => _discountType = 1'>
                            </span>
                            <span class="ms-5">
                                <span class="fs-4 fw-bold text-gray-800 d-block">Nenhum</span>
                            </span>
                        </label>
                    </div>
                    <div class="col">
                        <label class="btn btn-outline btn-outline-dashed btn-active-light-primary d-flex text-start p-6 @(_discountType == 2 ? "active" : "")" data-kt-button="true">
                            <span class="form-check form-check-custom form-check-solid form-check-sm align-items-start mt-1">
                                <input class="form-check-input" type="radio" name="discount_option" value="2" checked="@(_discountType == 2)" @onchange='() => _discountType = 2'>
                            </span>
                            <span class="ms-5">
                                <span class="fs-4 fw-bold text-gray-800 d-block">Porcentagem %</span>
                            </span>
                        </label>
                    </div>
                    <div class="col">
                        <label class="btn btn-outline btn-outline-dashed btn-active-light-primary d-flex text-start p-6 @(_discountType == 3 ? "active" : "")" data-kt-button="true">
                            <span class="form-check form-check-custom form-check-solid form-check-sm align-items-start mt-1">
                                <input class="form-check-input" type="radio" name="discount_option" value="3" checked="@(_discountType == 3)" @onchange='() => _discountType = 3'>
                            </span>
                            <span class="ms-5">
                                <span class="fs-4 fw-bold text-gray-800 d-block">Preço fixo</span>
                            </span>
                        </label>
                    </div>
                </div>

                @if (_discountType != 1)
                {
                    <div class="d-flex flex-wrap gap-5 mt-5">
                        <div class="fv-row w-100 flex-md-root">
                            @switch (_discountType)
                            {
                                case 2:
                                    <label class="form-label">Porcentagem (%)</label>
                                    <div class="d-flex align-items-center position-relative">
                                        <span class="fs-6 fw-semibold position-absolute ms-4 text-gray-700">%</span>
                                        <input type="text" class="form-control form-control-solid w-100 ps-12 money" onclick="this.select();" placeholder="0,00" autocomplete="off" @bind="@(_discountValue)" @onkeyup="async (e) => await EnterKeyPressAsync(e.Key)">
                                    </div>
                                    break;
                                case 3:
                                    <label class="form-label">Valor (R$)</label>
                                    <div class="d-flex align-items-center position-relative">
                                        <span class="fs-6 fw-semibold position-absolute ms-4 text-gray-700">R$</span>
                                        <input type="text" class="form-control form-control-solid w-100 ps-12 money" onclick="this.select();" placeholder="0,00" autocomplete="off" @bind="@(_discountValue)" @onkeyup="async (e) => await EnterKeyPressAsync(e.Key)">
                                    </div>
                                    break;
                            }
                        </div>
                    </div>
                }

                <div class="text-center mt-8">
                    <button type="button" class="btn btn-light me-3">
                        Fechar
                    </button>
                    <button type="button" class="btn btn-success" @onclick="async () => await SaveAsync()">Confirmar</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code
{
    [Parameter]
    public EventCallback<(int, decimal)> OnSaved { get; set; }

    private int _discountType = 1;
    private decimal _discountValue;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JsRuntime.InvokeVoidAsync("OnModalShow.Select", "order_discount_modal", "discountValue");
    }

    async Task SaveAsync()
    {
        await CloseAsync();
        await OnSaved.InvokeAsync((_discountType, _discountValue));
    }
    
    async Task EnterKeyPressAsync(string keyPress)
    {
        if (keyPress != "Enter")
            return;

        await SaveAsync();
    }

    async Task CloseAsync() => await JsRuntime.InvokeVoidAsync("Modal.Close", "order_discount_modal");
}