@page "/orders"
@page "/"

@attribute [Authorize(Policy = Policies.SubscriptionActive)]

@inject ProtectedSessionStorage SessionStore
@inject DataRequest DataRequest
@inject SweetAlertService SweetAlertService
@inject IJSRuntime JsRuntime

<div class="d-flex flex-column flex-column-fluid">
<div id="kt_app_toolbar" class="app-toolbar mt-8">
    <div id="kt_app_toolbar_container" class="app-container container-xxl d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center me-3 ">
            <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">
                Pedidos
            </h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-6 my-0 pt-1">
                <li class="breadcrumb-item text-muted">
                    <a class="text-muted text-hover-success">
                        Veja os pedidos que a sua loja recebeu no Quantso
                    </a>
                </li>
            </ul>
        </div>
        <div class="d-flex align-items-center gap-4">
            <div class="me-0">
                <button class="btn btn-sm fw-bold btn-secondary" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">
                    Operações <i class="ki-duotone ki-down fs-5"></i>
                </button>
                <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold w-200px py-3" data-kt-menu="true" style="">
                    <div class="menu-item px-3">
                        <div class="menu-content text-muted pb-2 px-3 fs-7 text-uppercase">
                            Operações em lote
                        </div>
                    </div>
                    <div class="menu-item px-3">
                        <a class="menu-link px-3" @onclick="async () => await OpenPreparationModalAsync()">
                            Iniciar preparo
                        </a>
                    </div>
                    <div class="menu-item px-3">
                        <a class="menu-link px-3" @onclick="async () => await OpenDispatchModalAsync()">
                            Despachar pedido
                        </a>
                    </div>
                    <div class="menu-item px-3">
                        <a class="menu-link px-3" @onclick="async () => await OpenCancelModalAsync()">
                            Cancelar pedido
                        </a>
                    </div>
                </div>
            </div>
            <a href="/order/create" class="btn btn-sm fw-bold btn-success">
                Criar pedido
            </a>
        </div>
    </div>
</div>
<div id="kt_app_content" class="app-content flex-column-fluid">
    <div id="kt_app_content_container" class="app-container container-xxl">
        <div class="card card-flush">
            <div class="card-header align-items-center py-5 gap-2 gap-md-5">
                <div class="row col-12">
                    <div class="col-3">
                        <label class="fw-semibold fs-6 mb-2 text-gray-600">Número do pedido</label>
                        <div class="d-flex align-items-center position-relative my-1">
                            <input type="text" class="form-control form-control-solid border-1 number" onclick="this.select();" placeholder="Número do pedido" @bind="@(_number)"/>
                        </div>
                    </div>
                    <div class="col-3">
                        <label class="fw-semibold fs-6 mb-2 text-gray-600">Status do pedido</label>
                        <div class="d-flex align-items-center position-relative my-1">
                            <select class="form-select form-select-solid" placeholder="Status" data-placeholder="Status" @bind="_status">
                                <option value="0">Todos</option>
                                <option value="1">Pendente</option>
                                <option value="2">Confirmado</option>
                                <option value="3">Preparando</option>
                                <option value="4">Entregando</option>
                                <option value="5">Finalizado</option>
                                <option value="9">Cancelado</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-3">
                        <label class="fw-semibold fs-6 mb-2 text-gray-600">De</label>
                        <div class="d-flex align-items-center position-relative my-1">
                            <input type="text" name="dateFilterFrom" class="form-control form-control-solid flatpicker" placeholder="dd/mm/aaaa" value="@(_fromDate?.ToString("d"))"/>
                        </div>
                    </div>
                    <div class="col-3">
                        <label class="fw-semibold fs-6 mb-2 text-gray-600">Até</label>
                        <div class="d-flex align-items-center position-relative my-1">
                            <input type="text" name="dateFilterTo" class="form-control form-control-solid flatpicker" placeholder="dd/mm/aaaa" value="@(_toDate?.ToString("d"))"/>
                        </div>
                    </div>
                </div>
                <div class="row col-12">
                    <div class="col-3">
                        @if (_loading)
                        {
                            <_LoadingButton Class="btn-sm btn-secondary"/>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-secondary" @onclick="async () => await SearchAsync(0)">Consultar</button>
                        }
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-center flex-wrap d-grid gap-2">
                            <div class="d-flex align-items-center me-5 me-xl-13">
                                <div class="m-0">
                                    <span class="fw-semibold text-gray-400 d-block fs-8">De:</span>
                                    @if (_fromDate != null)
                                    {
                                        <span class="fw-bold text-gray-800 fs-7">@(DateTimeUtils.PeriodLayout(_fromDate.Value))</span>    
                                    }
                                </div>
                            </div>
                            <div class="d-flex align-items-center">
                                <div class="m-0">
                                    <span class="fw-semibold text-gray-400 d-block fs-8">Até:</span>
                                    @if (_toDate != null)
                                    {
                                        <span class="fw-bold text-gray-800 fs-7">@(DateTimeUtils.PeriodLayout(_toDate.Value))</span>    
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-3 text-end">
                        <span class="cursor-pointer fw-semibold text-success d-block fs-7" @onclick="async () => await OpenParameterModalAsync()">Parametrização</span>
                    </div>
                </div>
            </div>
            <div class="card-body pt-2">
                @if (_orders != null)
                {
                    if (_orders.Count == 0)
                    {
                        <div class="fw-semibold fs-6 text-gray-500 mt-5 mb-0">
                            Nenhum pedido encontrado com esses filtros.
                        </div>
                    }

                    foreach (IGrouping<DateTime, OrderModel> orderGrouped in _orders.OrderByDescending(x => x.CreatedAt).GroupBy(x => x.CreatedAt.Date))
                    {
                        <label class="btn btn-outline btn-outline-dashed d-flex flex-stack text-start p-6">
                            <div class="d-flex align-items-center me-2">
                                <div class="flex-grow-1">
                                    <h2 class="d-flex align-items-center fs-3 fw-bold flex-wrap">@(orderGrouped.Key.ToString("D"))</h2>
                                    <div class="fw-semibold opacity-50">@(orderGrouped.Count(x => x.Status != OrderStatusConst.Canceled)) @(orderGrouped.Count(x => x.Status != OrderStatusConst.Canceled) > 1 ? "pedidos" : "pedido")</div>
                                </div>
                            </div>
                            <div class="ms-5">
                                <span class="mb-2">R$</span>
                                <span class="fs-2 fw-bold">@(CurrencyUtils.MoneyWithoutCurrency(orderGrouped.Where(x => x.Status != OrderStatusConst.Canceled).Sum(x => x.TotalValue)))</span>
                                <span class="fs-7 opacity-50">
                                    /
                                    <span data-kt-element="period">dia</span>
                                </span>
                            </div>
                        </label>
                        <div class="p-4 pb-0">
                            <table class="table align-middle table-hover table-row-dashed fs-6 gy-3">
                                <thead>
                                <tr class="text-center text-gray-400 fw-bold fs-7 text-uppercase gs-0">
                                    <th class="text-start">Status</th>
                                    <th>Pedido</th>
                                    <th>Entrega</th>
                                    <th>Modo</th>
                                    <th>Total</th>
                                    <th class="text-end min-w-40px"></th>
                                </tr>
                                </thead>
                                <tbody class="fw-semibold text-gray-600 text-center">
                                @foreach (OrderModel order in orderGrouped)
                                {
                                    <tr>
                                        <td class="text-start">
                                            <_OrderStatus Status="@(order.Status)"/>
                                        </td>
                                        <td class="ps-0">
                                            <span class="text-gray-800 fw-semibold mb-1 fs-6 text-start pe-0 align-content-center">#@(order.Number)</span>
                                            <span class="text-gray-600 fw-semibold fs-7 d-block text-center ps-0">@(order.CreatedAt.ToShortTimeString())</span>
                                        </td>
                                        <td class="ps-0">
                                            <span class="text-gray-800 fw-semibold mb-1 fs-6 text-start pe-0">@(DateTimeUtils.PeriodLayout(order.DeliveryEstimateBeginAt))</span>
                                            <span class="text-gray-600 fw-semibold fs-7 d-block text-center ps-0">@($"{order.DeliveryEstimateBeginAt.ToShortTimeString()} - {order.DeliveryEstimateEndAt.ToShortTimeString()}")</span>
                                        </td>
                                        <td class="ps-0">
                                            <span class="text-gray-800 fw-semibold mb-1 fs-6 text-start pe-0">@(order.GetDeliveryType())</span>
                                            @if (!string.IsNullOrEmpty(order.Collaborator?.Name))
                                            {
                                                <span class="text-gray-600 fw-semibold fs-7 d-block text-center ps-0">@(order.Collaborator?.Name)</span>
                                            }
                                        </td>
                                        <td class="ps-0">
                                            <span class="text-gray-800 fw-semibold mb-1 fs-6 text-start pe-0">@(CurrencyUtils.MoneyFormat(order.TotalValue))</span>
                                            @if (order.PaymentMethod != null)
                                            {
                                                <span class="text-gray-600 fw-semibold fs-7 d-block text-center ps-0">@(order.PaymentMethod.Description)</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="me-0">
                                                <button class="btn btn-sm btn-icon btn-bg-light btn-active-color-primary" type="button" data-kt-menu-trigger="click" title="Detalhes">
                                                    <i class="ki-solid ki-dots-horizontal fs-2x me-1"></i>
                                                </button>
                                                <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-800 menu-state-bg-light-primary fw-semibold w-200px py-3" data-kt-menu="true">
                                                    <div class="menu-item px-3">
                                                        <a class="menu-link flex-stack px-3" @onclick="async () => await OpenOrderDetailAsync(order.Id)">
                                                            Detalhes
                                                            <span class="ms-2" data-bs-toggle="tooltip" title="Detalhes do pedido">
                                                                <i class="ki-outline ki-files-tablet fs-6"></i>
                                                            </span>
                                                        </a>
                                                    </div>
                                                    @if (order.Status == OrderStatusConst.Pending)
                                                    {
                                                        <div class="menu-item px-3">
                                                            <a class="menu-link flex-stack cursor-pointer px-3" @onclick="async () => await UpdateOrderStatusAsync(order.Id, OrderStatusConst.Preparation)">
                                                                Aceitar
                                                                <span class="ms-2" data-bs-toggle="tooltip" title="Aceitar pedido">
                                                                    <i class="ki-outline ki-check-square fs-6"></i>
                                                                </span>
                                                            </a>
                                                        </div>
                                                    }

                                                    @if (order.Status == OrderStatusConst.Confirmed)
                                                    {
                                                        <div class="menu-item px-3">
                                                            <a class="menu-link flex-stack cursor-pointer px-3" @onclick="async () => await UpdateOrderStatusAsync(order.Id, OrderStatusConst.Preparation)">
                                                                Iniciar Preparo
                                                                <span class="ms-2" data-bs-toggle="tooltip" title="Iniciar preparo do pedido">
                                                                    <i class="ki-outline ki-watch fs-6"></i>
                                                                </span>
                                                            </a>
                                                        </div>
                                                    }

                                                    @if (order.Status == OrderStatusConst.Preparation)
                                                    {
                                                        if (order.DeliveryTypeId == OrderDeliveryTypeConst.Delivery)
                                                        {
                                                            <div class="menu-item px-3">
                                                                <a class="menu-link flex-stack cursor-pointer px-3" @onclick="async () => await OpenDispatchModalAsync(order.Id, order.Number)">
                                                                    Despachar
                                                                    <span class="ms-2" data-bs-toggle="tooltip" title="Despachar pedido para entrega">
                                                                        <i class="ki-outline ki-delivery-time fs-6"></i>
                                                                    </span>
                                                                </a>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="menu-item px-3">
                                                                <a class="menu-link flex-stack cursor-pointer px-3" @onclick="async () => await UpdateOrderStatusAsync(order.Id, OrderStatusConst.Finished)">
                                                                    Concluir
                                                                    <span class="ms-2" data-bs-toggle="tooltip" title="Concluir pedido">
                                                                        <i class="ki-outline ki-check-circle fs-6"></i>
                                                                    </span>
                                                                </a>
                                                            </div>
                                                        }
                                                    }

                                                    @if (order.Status == OrderStatusConst.Delivery)
                                                    {
                                                        <div class="menu-item px-3">
                                                            <a class="menu-link flex-stack cursor-pointer px-3" @onclick="async () => await UpdateOrderStatusAsync(order.Id, OrderStatusConst.Finished)">
                                                                Concluir
                                                                <span class="ms-2" data-bs-toggle="tooltip" title="Concluir pedido">
                                                                    <i class="ki-outline ki-check-circle fs-6"></i>
                                                                </span>
                                                            </a>
                                                        </div>
                                                    }

                                                    @if (order.Status != OrderStatusConst.Canceled && order.Status != OrderStatusConst.Finished)
                                                    {
                                                        <div class="menu-item px-3">
                                                            <a class="menu-link flex-stack cursor-pointer px-3">
                                                                Cancelar
                                                                <span class="ms-2" data-bs-toggle="tooltip" title="Cancelar pedido">
                                                                    <i class="ki-outline ki-cross-square fs-6"></i>
                                                                </span>
                                                            </a>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
</div>

<_OrderDetail Order="_orderDetail" Name="order_detail_modal"/>
<ParameterModal Settings="@(MainLayout?.Store?.StoreSettings)" OnSaved="ParameterCallback"/>

@if (_orders != null)
{
    <PreparationModal Orders="@(_orders.Where(x => x.Status is OrderStatusConst.Confirmed or OrderStatusConst.Pending).ToList())" OnSaved="async (e) => await PreparationCallbackAsync(e)"/>
    <CancelModal Orders="@(_orders.Where(x => x.Status != OrderStatusConst.Canceled && x.Status != OrderStatusConst.Finished).ToList())" OnSaved="async (e) => await CancelCallbackAsync(e)"/>
    <DispatchModal Orders="@(_orders.Where(x => (x.Status is OrderStatusConst.Pending or OrderStatusConst.Confirmed or OrderStatusConst.Preparation) && x.DeliveryTypeId == OrderDeliveryTypeConst.Delivery).ToList())" OnSaved="async (e) => await DeliveryCallbackAsync(e)"/>
}

@if (_orderDispatchId > 0)
{
    <DispatchItemModal OrderId="@(_orderDispatchId)" OrderNumber="@(_orderDispatchNumber)" OnSaved="async (e) => await DispatchCallbackAsync(e.Colaborator, e.OrderId)"/>
}

@code
{
    [CascadingParameter]
    protected MainLayout? MainLayout { get; set; }

    private List<OrderModel>? _orders;
    private OrderModel? _orderDetail;

    private DateTime? _fromDate;
    private DateTime? _toDate;
    private int? _number;
    private int? _status;
    private int _orderDispatchId;
    private int _orderDispatchNumber;

    private bool _loading;
  
    protected override async Task OnParametersSetAsync()
    {
        if (MainLayout?.Store?.StoreSettings != null && _fromDate != null && _toDate != null)
        {
            await SearchAsync(0);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("GLOBAL.SetDotnetReference", DotNetObjectReference.Create(this));
            await JsRuntime.InvokeVoidAsync("DatePicker.Order", "input.flatpicker", "SetDateFromDatePicker");
            await JsRuntime.InvokeVoidAsync("InputMask.Number");
            
            ProtectedBrowserStorageResult<string?> fromDate = await SessionStore.GetAsync<string?>("delivery3_order_begin");
            _fromDate = string.IsNullOrEmpty(fromDate.Value) ? DateTime.Now.Date : DateTime.Parse(fromDate.Value).Date;
            
            ProtectedBrowserStorageResult<string?> toDate = await SessionStore.GetAsync<string?>("delivery3_order_end");
            _toDate = string.IsNullOrEmpty(toDate.Value) ? DateTime.Now.AddDays(1).Date : DateTime.Parse(toDate.Value).Date;

            await SearchAsync(0);
            
            _orderDetail = null;
        }
    }

    async Task OpenOrderDetailAsync(int orderId)
    {
        if (_orders == null)
            return;

        _orderDetail = _orders.FirstOrDefault(x => x.Id == orderId);

        await JsRuntime.InvokeVoidAsync("Modal.Show", "order_detail_modal");
    }

    async Task OpenPreparationModalAsync()
    {
        await JsRuntime.InvokeVoidAsync("Modal.Show", "order_preparation_modal");
    }

    async Task OpenDispatchModalAsync()
    {
        await JsRuntime.InvokeVoidAsync("Modal.Show", "order_dispatch_modal");
    }

    async Task OpenDispatchModalAsync(int orderId, int orderNumber)
    {
        _orderDispatchId = orderId;
        _orderDispatchNumber = orderNumber;
        StateHasChanged();
        await JsRuntime.InvokeVoidAsync("Modal.Show", "order_workflow_dispatch_item_modal");
        await JsRuntime.InvokeVoidAsync("Modal.Show", "order_workflow_dispatch_item_modal");
    }

    async Task OpenCancelModalAsync()
    {
        await JsRuntime.InvokeVoidAsync("Modal.Show", "order_cancel_modal");
    }

    async Task OpenParameterModalAsync()
    {
        await JsRuntime.InvokeVoidAsync("Modal.Show", "order_parameter_modal");
    }

    async Task UpdateOrderStatusAsync(int orderId, int status)
    {
        if (_orders == null)
            return;

        _orders.First(x => x.Id == orderId).IsLoading = true;
        await Task.Delay(TimeSpan.FromSeconds(0.5));

        ApiResponse response = await DataRequest.SendAsync(HttpMethod.Put, "/order/status", new
        {
            Status = status,
            OrderIds = new List<int>(1) { orderId }
        });

        _orders.First(x => x.Id == orderId).IsLoading = false;

        if (!response.IsSuccessRequest)
        {
            await JsRuntime.InvokeVoidAsync("Toastr.Error", response.Error);
            return;
        }

        _orders.First(x => x.Id == orderId).Status = status;

        if (MainLayout != null)
            await MainLayout.OnRefreshOrderAsync();
    }

    async Task DeclineOrderAsync(int orderId, int orderNumber)
    {
        if (_orders == null)
            return;

        SweetAlertResult result = await SweetAlertService.FireAsync(new SweetAlertOptions
        {
            Title = "Atenção!",
            Text = $"Essa operação irá cancelar o pedido nº {orderNumber}. Deseja confirmar?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Confirmar",
            ConfirmButtonColor = "#F1416C",
            CancelButtonText = "Cancelar"
        });

        if (!string.IsNullOrEmpty(result.Value))
            await UpdateOrderStatusAsync(orderId, 9);
    }

    async Task PreparationCallbackAsync(ICollection<int> orderIds)
    {
        if (_orders == null)
            return;

        foreach (OrderModel orderModel in _orders.Where(x => orderIds.Contains(x.Id)))
            orderModel.Status = OrderStatusConst.Preparation;

        if (MainLayout != null)
            await MainLayout.OnRefreshOrderAsync();
    }

    async Task CancelCallbackAsync(List<int> orderIds)
    {
        if (_orders == null)
            return;

        foreach (OrderModel orderModel in _orders.Where(x => orderIds.Contains(x.Id)))
            orderModel.Status = OrderStatusConst.Canceled;

        if (MainLayout != null)
            await MainLayout.OnRefreshOrderAsync();
    }

    async Task DeliveryCallbackAsync((CollaboratorModal? Colaborator, List<int> OrderIds) resp)
    {
        if (_orders == null)
            return;

        foreach (OrderModel orderModel in _orders.Where(x => resp.OrderIds.Contains(x.Id)))
        {
            orderModel.Status = OrderStatusConst.Delivery;
            orderModel.CollaboratorId = resp.Colaborator?.Id;
            orderModel.Collaborator = resp.Colaborator;
        }

        if (MainLayout != null)
            await MainLayout.OnRefreshOrderAsync();
    }

    void ParameterCallback((int FilterOrderDateType, int FilterOrderSortType, int FilterOrderSortAsc) resp)
    {
        if (MainLayout?.Store?.StoreSettings == null)
            return;

        MainLayout.Store.StoreSettings.FilterOrderDateType = resp.FilterOrderDateType;
        MainLayout.Store.StoreSettings.FilterOrderSortType = resp.FilterOrderSortType;
        MainLayout.Store.StoreSettings.FilterOrderSortAsc = resp.FilterOrderSortAsc;

        StateHasChanged();
    }

    async Task DispatchCallbackAsync(CollaboratorModal? collaborator, int orderId)
    {
        if (_orders == null)
            return;

        _orders.First(x => x.Id == orderId).Status = OrderStatusConst.Delivery;
        _orders.First(x => x.Id == orderId).Collaborator = collaborator;

        if (MainLayout != null)
            await MainLayout.OnRefreshOrderAsync();
    }

    async Task SearchAsync(int filter)
    {
        _loading = true;

        await Task.Delay(TimeSpan.FromSeconds(0.5));

        ApiResponse response = await DataRequest.SendAsync(HttpMethod.Get, $"/order?number={_number ?? 0}&status={_status ?? 0}&from={_fromDate:yyyy-MM-dd}&to={_toDate:yyyy-MM-dd}&filter={filter}");
        _loading = false;

        if (!response.IsSuccessRequest)
        {
            await JsRuntime.InvokeVoidAsync("Toastr.Error", response.Error);
            return;
        }

        try
        {
            if (_fromDate != null && _toDate != null)
            {
                await SessionStore.SetAsync("delivery3_order_begin", _fromDate.Value.ToShortDateString());
                await SessionStore.SetAsync("delivery3_order_end", _toDate.Value.ToShortDateString());    
            }
        }
        catch (Exception e)
        {
            // ignored
        }

        _orders = JsonConvert.DeserializeObject<List<OrderModel>>(response.Json ?? string.Empty);
        StateHasChanged();
    }

    [JSInvokable("SetDateFromDatePicker")]
    public void SetDateFromDatePicker(DatePicker datePicker)
    {
        if (datePicker.Input == "dateFilterFrom")
            _fromDate = DateTime.Parse(datePicker.DateStr ?? DateTimeUtils.Now().ToString(CultureInfo.InvariantCulture));
        else if (datePicker.Input == "dateFilterTo")
            _toDate = DateTime.Parse(datePicker.DateStr ?? DateTimeUtils.Now().ToString(CultureInfo.InvariantCulture));

        StateHasChanged();
    }

    public class DatePicker
    {
        public string? Input { get; set; }
        public string? DateStr { get; set; }
    }
}