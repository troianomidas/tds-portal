@page "/reviews/"
@using WebApp.Models.Reviews
@using System.Globalization
@using WebApp.Pages.Review.Modals
@inject IJSRuntime JsRuntime
@inject DataRequest DataRequest

@attribute [Authorize]

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar mt-10">
        <div id="kt_app_toolbar_container" class="app-container container-xxl d-flex flex-stack">
            <div class="page-title d-flex flex-column justify-content-center me-3 ">
                <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">
                    Lista de Avaliações
                </h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
                    <li class="breadcrumb-item text-muted">
                        <a href="#" class="text-muted text-hover-primary">
                            Início
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        <span class="bullet bg-gray-400 w-5px h-2px"></span>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Avaliações
                    </li>
                </ul>
            </div>
            <div class="d-flex align-items-center gap-2">
            </div>
        </div>
    </div>
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="app-container container-xxl">
            <div class="card card-flush">
                <div class="card-header align-items-center py-5 gap-2 gap-md-5">
                    <div class="row col-12">
                        <div class="col-3">
                            <label class="fw-semibold fs-6 mb-2 text-gray-600">De</label>
                            <input type="text" name="dateFilterFrom" class="form-control form-control-solid flatpickr" placeholder="dd/mm/aaaa" value="@(_fromDate.ToString("d"))"/>
                        </div>
                        <div class="col-3">
                            <label class="fw-semibold fs-6 mb-2 text-gray-600">Até</label>
                            <input type="text" name="dateFilterTo" class="form-control form-control-solid flatpickr" placeholder="dd/mm/aaaa" value="@(_toDate.ToString("d"))"/>
                        </div>
                        <div class="col-3 mt-8">
                            @if (_loading)
                            {
                                <_LoadingButton Class="btn-primary"/>
                            }
                            else
                            {
                                <button type="button" class="btn btn-primary btn-block" @onclick="async () => await LoadPaginateAsync()">Consultar</button>
                            }
                        </div>
                    </div>
                </div>
                @if (_reviews != null)
                {
                    @foreach (ListReviewResponseSegment review in _reviews!.Items)
                    {
                        <div class="card card-flush mb-10">
                            <div class="card-header pt-9">
                                <div class="d-flex align-items-center">
                                    <div class="symbol symbol-90px me-5">
                                        <img src="assets/media/stock/1600x800/file.png" class="" alt=""/>
                                    </div>
                                    <div class="flex-grow-1">
                                        <span class="text-gray-800  fs-4 fw-bold">@(review.Order?.CustomerName)</span>
                                        <span class="text-gray-600 fw-semibold d-block">@DateTimeUtils.GetFormattedDiffTime(review.CreatedAt!.Value)</span>
                                        <span class="text-gray-600 fw-semibold d-block">Avaliação do pedido Nº @(review.Order?.Number)</span>
                                        <a class="cursor-pointer" data-bs-toggle="modal" data-bs-target="#kt_review_detail_modal" @onclick="async () => await OpenReviewDetailModal(review)">
                                            Exibir detalhes do Pedido
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="fs-6 fw-normal text-start text-gray-700 mb-5">
                                    @(review.Comment)
                                </div>
                            </div>
                        </div>
                    }
                    <div class="row">
                        <div class="col-sm-12 col-md-7 d-flex align-items-center justify-content-center justify-content-md-end">
                            <div class="dataTables_paginate paging_simple_numbers">
                                <ul class="pagination" style="pointer-events: @(_loading ? "none" : "")">
                                    <li class="page-item first">
                                        <span @onclick="async () => await PaginateAsync(0, 1)" class="page-link px-0 cursor-pointer">
                                            <span class="svg-icon svg-icon-2">
                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <path opacity="0.5" d="M14.2657 11.4343L18.45 7.25C18.8642 6.83579 18.8642 6.16421 18.45 5.75C18.0358 5.33579 17.3642 5.33579 16.95 5.75L11.4071 11.2929C11.0166 11.6834 11.0166 12.3166 11.4071 12.7071L16.95 18.25C17.3642 18.6642 18.0358 18.6642 18.45 18.25C18.8642 17.8358 18.8642 17.1642 18.45 16.75L14.2657 12.5657C13.9533 12.2533 13.9533 11.7467 14.2657 11.4343Z" fill="currentColor"></path>
                                                    <path d="M8.2657 11.4343L12.45 7.25C12.8642 6.83579 12.8642 6.16421 12.45 5.75C12.0358 5.33579 11.3642 5.33579 10.95 5.75L5.40712 11.2929C5.01659 11.6834 5.01659 12.3166 5.40712 12.7071L10.95 18.25C11.3642 18.6642 12.0358 18.6642 12.45 18.25C12.8642 17.8358 12.8642 17.1642 12.45 16.75L8.2657 12.5657C7.95328 12.2533 7.95328 11.7467 8.2657 11.4343Z" fill="currentColor"></path>
                                                </svg>
                                            </span>
                                        </span>
                                    </li>
                                    <li class="page-item previous @(_reviews?.HasPreviousPage == true ? "" : "disabled")">
                                        <span @onclick="async () => await PaginateAsync(-1)" class="page-link cursor-pointer">
                                            <i class="previous"></i>
                                        </span>
                                    </li>
                                    @if (_reviews?.HasPreviousPage ?? false)
                                    {
                                        <li class="page-item">
                                            <span class="page-link cursor-pointer">@(_reviews?.PageNumber - 1)</span>
                                        </li>
                                    }
                                    <li class="page-item active">
                                        <span class="page-link cursor-pointer">@(_reviews?.PageNumber)</span>
                                    </li>
                                    @if (_reviews?.HasNextPage ?? false)
                                    {
                                        <li class="page-item">
                                            <span class="page-link cursor-pointer">@(_reviews?.PageNumber + 1)</span>
                                        </li>
                                    }
                                    <li class="page-item next @(_reviews?.HasNextPage == true ? "" : "disabled")">
                                        <span @onclick="async () => await PaginateAsync(1)" class="page-link cursor-pointer">
                                            <i class="next"></i>
                                        </span>
                                    </li>
                                    <li class="page-item first">
                                        <span @onclick="async () => await PaginateAsync(0, _reviews?.TotalPages ?? 1)" class="page-link px-0 cursor-pointer">
                                            <span class="svg-icon svg-icon-2">
                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <path opacity="0.5" d="M9.63433 11.4343L5.45001 7.25C5.0358 6.83579 5.0358 6.16421 5.45001 5.75C5.86423 5.33579 6.5358 5.33579 6.95001 5.75L12.4929 11.2929C12.8834 11.6834 12.8834 12.3166 12.4929 12.7071L6.95001 18.25C6.5358 18.6642 5.86423 18.6642 5.45001 18.25C5.0358 17.8358 5.0358 17.1642 5.45001 16.75L9.63433 12.5657C9.94675 12.2533 9.94675 11.7467 9.63433 11.4343Z" fill="currentColor"></path>
                                                    <path d="M15.6343 11.4343L11.45 7.25C11.0358 6.83579 11.0358 6.16421 11.45 5.75C11.8642 5.33579 12.5358 5.33579 12.95 5.75L18.4929 11.2929C18.8834 11.6834 18.8834 12.3166 18.4929 12.7071L12.95 18.25C12.5358 18.6642 11.8642 18.6642 11.45 18.25C11.0358 17.8358 11.0358 17.1642 11.45 16.75L15.6343 12.5657C15.9467 12.2533 15.9467 11.7467 15.6343 11.4343Z" fill="currentColor"></path>
                                                </svg>
                                            </span>
                                        </span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-7 d-flex align-items-center justify-content-center justify-content-md-end">
                            <div class="dataTables_paginate paging_simple_numbers">
                                <ul class="pagination" style="">
                                    <li class="page-item first">
                                    </li>
                                    <li class="page-item first">
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <h2>Voce nao tem avaliaçoes</h2>
                }
            </div>
        </div>
    </div>
</div>
@if (_reviewDetails != null)
{
    <_ReviewModal Review="_reviewDetails"/>
}

@code {

    private ListReviewResponse? _reviews;
    private ListReviewResponseSegment? _reviewDetails;
    private bool _loading;
    private string _limit = "10";
    private int _page = 1;
    private DateTime _fromDate;
    private DateTime _toDate;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("GLOBAL.SetDotnetReference", DotNetObjectReference.Create(this));
            await JsRuntime.InvokeVoidAsync("DatePicker.Order", "input.flatpickr");
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPaginateAsync();
    }

    async Task OpenReviewDetailModal(ListReviewResponseSegment review)
    {
        if (review != null)
        {
            _reviewDetails = review;
        }
        await JsRuntime.InvokeVoidAsync("Modal.Show", "kt_review_detail_modal");
    }

    async Task PaginateAsync(int page, int totalPage = 0)
    {
        _loading = true;

        await Task.Delay(TimeSpan.FromSeconds(0.5));

        if (_reviews != null)
            _page += page;

        if (_page < 1)
            _page = 1;

        if (totalPage > 0)
            _page = totalPage;

        await LoadPaginateAsync();

        _loading = false;
        StateHasChanged();
    }

    async Task LoadPaginateAsync()
    {
        _loading = true;
        ApiResponse response = await DataRequest.SendAsync(HttpMethod.Get, $"/review?limit={_limit}&page={_page}&from={_fromDate.ToString("yyyy-MM-dd")}&to={_toDate.ToString("yyyy-MM-dd")}");
        _loading = false;

        if (!response.IsSuccessRequest)
        {
            Console.WriteLine(response.Error);
            return;
        }
        _reviews = JsonConvert.DeserializeObject<ListReviewResponse>(response.Json ?? string.Empty);
    }

    [JSInvokable("SetDateFromDatePicker")]
    public void SetDateFromDatePicker(DatePicker datePicker)
    {
        if (datePicker.Input == "dateFilterFrom")
            _fromDate = DateTime.Parse(datePicker.DateStr ?? DateTimeUtils.Now().ToString(CultureInfo.InvariantCulture));
        else if (datePicker.Input == "dateFilterTo")
            _toDate = DateTime.Parse(datePicker.DateStr ?? DateTimeUtils.Now().ToString(CultureInfo.InvariantCulture));

        StateHasChanged();
    }

    public class DatePicker
    {
        public string? Input { get; set; }
        public string? DateStr { get; set; }
    }

}
