@page "/collaborators"
@using WebApp.Constants

@attribute [Authorize(Policy = Policies.SubscriptionActive)]

@inject DataRequest DataRequest
@inject SweetAlertService SweetAlert
@inject IJSRuntime JsRuntime

<div class="d-flex flex-column flex-column-fluid">
    <div id="kt_app_toolbar" class="app-toolbar mt-8">
        <div id="kt_app_toolbar_container" class="app-container container-xxl d-flex flex-stack">
            <div class="page-title d-flex flex-column justify-content-center me-3 ">
                <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">
                    Colaboradores
                </h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-6 my-0 pt-1">
                    <li class="breadcrumb-item text-muted">
                        <a class="text-muted text-hover-success">
                            Facilite o gerenciamento de fornecedores e entregadores do seu estabelecimento
                        </a>
                    </li>
                </ul>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-success" @onclick="async () => await OpenCollaboratorModalAsync(false)">Cadastrar colaborador</button>
            </div>
        </div>
    </div>
    <div id="kt_app_content" class="app-content flex-column-fluid py-3 mt-5">
        <div id="kt_app_content_container" class="app-container container-xxl">
            <div class="row g-7">
                <div class="col-3">
                    <div class="card card-flush">
                        <div class="card-header pt-7" id="kt_chat_contacts_header">
                            <div class="card-title">
                                <h3>Grupos</h3>
                            </div>
                        </div>
                        <div class="card-body pt-5">
                            <div class="d-flex flex-column gap-5">
                                <div class="d-flex flex-stack">
                                    <span class="cursor-pointer fs-6 fw-bold text-gray-800 text-hover-success @(string.IsNullOrEmpty(_groupName) ? "text-active-success active" : "")" @onclick="() => _groupName = null">Todos</span>
                                    <div class="badge badge-light-success">@(_collaborators?.Count(x=> x.Status != 9))</div>
                                </div>
                                <div class="d-flex flex-stack">
                                    <span class="cursor-pointer fs-6 fw-bold text-gray-800 text-hover-success @(_groupName == "deliveryman" ? "text-active-success active" : "")"@onclick='() => _groupName = "deliveryman"'>Entregadores</span>
                                    <div class="badge badge-light-success">@(_collaborators?.Count(x => x.Status != 9 && x.GroupName == "deliveryman"))</div>
                                </div>
                                <div class="d-flex flex-stack">
                                    <span class="cursor-pointer fs-6 fw-bold text-gray-800 text-hover-success @(_groupName == "supplier" ? "text-active-success active" : "")" @onclick='() => _groupName = "supplier"'>Fornecedores</span>
                                    <div class="badge badge-light-success">@(_collaborators?.Count(x => x.Status != 9 && x.GroupName == "supplier"))</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="card card-flush" id="kt_contacts_list">
                        <div class="card-body pt-5" id="kt_contacts_list_body">
                            <div class="scroll-y me-n5 pe-5 h-300px h-xl-auto" data-kt-scroll="true" data-kt-scroll-activate="{default: false, lg: true}" data-kt-scroll-max-height="auto" data-kt-scroll-dependencies="#kt_header, #kt_toolbar, #kt_footer, #kt_contacts_list_header" data-kt-scroll-wrappers="#kt_content, #kt_contacts_list_body" data-kt-scroll-stretch="#kt_contacts_list, #kt_contacts_main" data-kt-scroll-offset="5px" style="max-height: 488px;">
                                @if (_collaborators == null)
                                {
                                    <p>Carregando...</p>
                                }
                                else
                                {
                                    if (string.IsNullOrEmpty(_groupName))
                                    {
                                        <h2>Todos</h2>    
                                    }
                                    else
                                    {
                                        <h2>@(_groupName == "deliveryman" ? "Entregadores" : "Fornecedores")</h2>
                                    }
                                    foreach (CollaboratorModal item in _collaborators.Where(x=> x.Status != 9 && (string.IsNullOrEmpty(_groupName) ? x.GroupName != null : x.GroupName == _groupName )))
                                    {
                                        <div class="d-flex flex-stack py-4">
                                            <div class="d-flex align-items-center cursor-pointer" @onclick="() => _collaborador = item">
                                                <div class="symbol symbol-40px symbol-circle">
                                                    <img alt="Pic" src="/assets/media/avatars/blank.png">
                                                </div>
                                                <div class="ms-4">
                                                    <span class="fs-6 fw-bold text-gray-900 text-hover-primary mb-2">@(item.Name)</span>
                                                    <div class="fw-semibold fs-7 text-muted">@(item.Phone)</div>
                                                    <div class="fw-semibold fs-7 text-muted">@(item.GetGroupDescription())</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="separator separator-dashed"></div>
                                    }
                                    if (_collaborators.Count(x=> x.Status != 9 && string.IsNullOrEmpty(_groupName) ? x.GroupName != null : x.GroupName == _groupName) == 0)
                                    {
                                        if (string.IsNullOrEmpty(_groupName))
                                        {
                                            <p>Nenhum colaborador cadastrado</p>    
                                        }
                                        else
                                        {
                                            <p>Nenhum @(_groupName == "deliveryman" ? "entregador" : "fornecedor") cadastrado</p>
                                        }
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-5">
                    <div class="card card-flush h-lg-100">
                        @if (_collaborador != null)
                        {
                            <div class="card-body pt-5">
                                <div class="d-flex gap-7 align-items-center">
                                    <div class="symbol symbol-circle symbol-40px">
                                        <img src="/assets/media/avatars/blank.png" alt="image">
                                    </div>
                                    <div class="d-flex flex-column gap-2">
                                        <h3 class="mb-0">@(_collaborador.Name)</h3>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-semibold text-muted text-hover-primary">@(_collaborador.Phone)</span>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-semibold text-muted text-hover-primary">@(_collaborador.GetGroupDescription())</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="p-0 mt-5">
                                    <button type="button" class="btn btn-secondary btn-sm me-3" @onclick="async () => await OpenCollaboratorModalAsync(true)">Editar</button>
                                    <button type="button" class="btn btn-light-danger btn-sm" @onclick="async () => await DeleteCollaboratorAsync()">Excluir</button>
                                </div>
                               <div class="tab-content">
                                    <div class="tab-pane fade show active" id="qtso_collaborador_geral" role="tabpanel">
                                        <div class="d-flex flex-column gap-5 mt-7">
                                            <div class="d-flex flex-column gap-1">
                                                <div class="fw-bold text-muted">Nome completo</div>
                                                <div class="fw-bold fs-6">@(_collaborador.Name)</div>
                                            </div>
                                            <div class="d-flex flex-column gap-1">
                                                <div class="fw-bold text-muted">Contato</div>
                                                <div class="fw-bold fs-6">@(_collaborador.Phone)</div>
                                            </div>
                                            <div class="d-flex flex-column gap-1">
                                                <div class="fw-bold text-muted">E-mail</div>
                                                <div class="fw-bold fs-6">@(_collaborador.Email ?? "-")</div>
                                            </div>
                                            <div class="d-flex flex-column gap-1">
                                                <div class="fw-bold text-muted">CPF ou CNPJ</div>
                                                <div class="fw-bold fs-6">@(_collaborador.Document ?? "-")</div>
                                            </div>
                                            <div class="d-flex flex-column gap-1">
                                                <div class="fw-bold text-muted">Descrição</div>
                                                <div class="fw-bold fs-6">@(_collaborador.Description ?? "-")</div>
                                            </div>
                                            <div class="d-flex flex-column gap-1">
                                                <div class="fw-bold text-muted">Cadastro</div>
                                                <div class="fw-bold fs-6">@(_collaborador.CreatedAt.ToShortDateString())</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="card-body pt-5">
                                <div class="card-px text-center py-10 my-10">
                                    <h2 class="fs-2x fw-bold mb-10">Colaboradores</h2>
                                    <p class="text-gray-400 fs-4 fw-semibold mb-0">
                                        Facilite o gerenciamento de novos membros da sua loja por meio de grupos de acesso
                                    </p>
                                </div>
                                <div class="text-center px-4">
                                    <img class="mw-100 mh-300px" alt="" src="/assets/media/illustrations/sketchy-1/5.png">
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<NewCollaboratorModal Collaborator="_collaboradorEdit" OnSave="async () => await LoadCollaboratorsAsync()"/>

@code
{
    private List<CollaboratorModal>? _collaborators;
    private CollaboratorModal? _collaborador;
    private CollaboratorModal? _collaboradorEdit = new();
    private string? _groupName;
    private bool _isEdit;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LoadCollaboratorsAsync();
    }

    async Task LoadCollaboratorsAsync()
    {
        await Task.Delay(TimeSpan.FromSeconds(0.2));
        ApiResponse response = await DataRequest.SendAsync(HttpMethod.Get, "/Collaborator");

        if (!response.IsSuccessRequest)
        {
            await JsRuntime.InvokeVoidAsync("Toastr.Error", response.Error);
            return;
        }

        _collaborators = JsonConvert.DeserializeObject<List<CollaboratorModal>>(response.Json ?? string.Empty);
        StateHasChanged();
    }

    async Task OpenCollaboratorModalAsync(bool isEdit)
    {
        _isEdit = isEdit;
        _collaboradorEdit = _isEdit ? _collaborador : new CollaboratorModal();
        await JsRuntime.InvokeVoidAsync("Modal.Show", "new_collaborator_modal");
    }

    async Task DeleteCollaboratorAsync()
    {
        SweetAlertResult result = await SweetAlert.FireAsync(new SweetAlertOptions
        {
            Title = "Atenção",
            Text = $"Essa operação irá excluir o colaborador '{_collaborador?.Name}' permanentemente. Deseja confirmar?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true,
            ConfirmButtonText = "Confirmar",
            ConfirmButtonColor = "#F1416C",
            CancelButtonText = "Cancelar"
        });

        if (!string.IsNullOrEmpty(result.Value))
        {
            ApiResponse response = await DataRequest.SendAsync(HttpMethod.Delete, "/Collaborator", new
            {
                CollaboratorId = _collaborador?.Id ?? 0
            });
            if (response.IsSuccessRequest)
            {
                await JsRuntime.InvokeVoidAsync("Toastr.Success", "colaborador excluído com sucesso");
                _collaborador = null;
                await LoadCollaboratorsAsync();
            }
            else
                await JsRuntime.InvokeVoidAsync("Toastr.Error", response.Error);
        }
    }
}