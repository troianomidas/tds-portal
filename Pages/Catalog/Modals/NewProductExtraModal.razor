@using System.Reflection
@inject IJSRuntime JsRuntime
@inject DataRequest DataRequest

<div class="modal fade" id="new_product_extra_modal" data-bs-backdrop="static" tabindex="-1" role="dialog" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered mw-850px">
        <div class="modal-content rounded">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-success" data-bs-dismiss="modal">
                    <i class="ki-outline ki-cross fs-1"></i>
                </div>
            </div>
            <div class="modal-body scroll-y mx-5 pt-0">
                <form id="kt_modal_new_target_form" class="form">
                    <div class="d-flex flex-column mb-5 fv-row form-floating">
                        <input type="text" class="form-control form-control-solid" autocomplete="off" placeholder="Nome do complemento" @bind="_name"/>
                        <label class="required fs-6 mb-2">Nome do complemento</label>
                    </div>
                    <div class="row g-9 mb-5">
                        <div class="col-6">
                            <label class="btn btn-outline btn-outline-dashed btn-active-light-success d-flex text-start p-4 @(!_isRequired ? "active" : "")">
                                <span class="form-check form-check-custom form-check-solid form-check-sm align-items-start mt-1">
                                    <input class="form-check-input" type="radio" name="isRequired" value="0" checked="@(!_isRequired)" @onchange="() => ChangeExtraRequired(false)">
                                </span>
                                <span class="ms-5">
                                    <span class="fs-4 fw-bold mb-1 d-block">Opcional</span>
                                    <span class="fw-semibold fs-7 text-gray-600">
                                        O cliente pode ou não selecionar os itens
                                    </span>
                                </span>
                            </label>
                        </div>
                        <div class="col-6">
                            <label class="btn btn-outline btn-outline-dashed btn-active-light-success d-flex text-start p-4 @(_isRequired ? "active" : "")">
                                <span class="form-check form-check-custom form-check-solid form-check-sm align-items-start mt-1">
                                    <input class="form-check-input" type="radio" name="isRequired" checked="@_isRequired" @onchange="() => ChangeExtraRequired(true)">
                                </span>
                                <span class="ms-5">
                                    <span class="fs-4 fw-bold mb-1 d-block">Obrigatório</span>
                                    <span class="fw-semibold fs-7 text-gray-600">
                                        O cliente deve selecionar 1 ou mais itens
                                    </span>
                                </span>
                            </label>
                        </div>
                    </div>

                    <div class="row g-9 mb-5">
                        <div class="col-6 fv-row">
                            <label class="fw-bold fs-6 mb-2">Qtde. min</label>
                            <i class="fas fa-exclamation-circle ms-2 fs-7" data-bs-toggle="tooltip" title="Define o mínimo que alguém pode pedir dos itens desse complemento."></i>
                            <_InputDialer Amount="_min" Disable="@(true)" OnChange="i => _min = i"/>
                        </div>
                        <div class="col-6 fv-row">
                            <label class="fs-6 fw-bold mb-2">Qtde. max</label>
                            <i class="fas fa-exclamation-circle ms-2 fs-7" data-bs-toggle="tooltip" title="Define o limite que alguém pode pedir dos itens desse complemento."></i>
                            <_InputDialer Amount="_max" Min="1" OnChange="i => _max = i"/>
                        </div>
                    </div>
                    <div class="table-responsive mb-10">
                        <table class="table g-4 gs-0 mb-5 fw-bold text-gray-700" data-kt-element="items">
                            <thead>
                            <tr class="border-bottom fs-7 fw-bold text-gray-700 text-uppercase">
                                <th class="w-60px"></th>
                                <th class="w-100px">Item</th>
                                <th class="w-150px">Descrição</th>
                                <th class="w-50px">Valor</th>
                                <th class="w-20px"></th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (ProductExtraItemModel item in _extraItems)
                            {
                                <tr class="border-bottom border-bottom-dashed mb-0 p-0" style="vertical-align: middle;">
                                    <td class="text-center">
                                        <_InputImage Width="40" Height="40" Thumbnail="@(item.ImageUrl)" OnUploaded="imageUrl => item.ImageUrl = imageUrl" OnRemove="s => item.ImageUrl = null"/>
                                    </td>
                                    <td class="text-center p-1">
                                        <input type="text" class="form-control form-control-sm form-control-solid mb-2" placeholder="Ex: Batata-frita" autocomplete="off" @bind="@(item.Name)">
                                    </td>
                                    <td class="text-center p-1">
                                        <input type="text" class="form-control form-control-sm form-control-solid mb-2" placeholder="Descrição" autocomplete="off" @bind="@(item.Description)">
                                    </td>
                                    <td class="text-end p-1">
                                        <div class="d-flex align-items-center position-relative mb-2">
                                            <span class="fs-6 fw-semibold position-absolute ms-4 text-gray-700">R$</span>
                                            <input type="text" class="form-control form-control-sm form-control-solid w-100 ps-12 money" onclick="this.select();" placeholder="0,00" autocomplete="off" @bind="@(item.UnitPrice)">
                                        </div>
                                    </td>
                                    <td class="text-end p-1">
                                        <button type="button" class="btn btn-sm btn-icon" @onclick="() => RemoveExtraItem(item.InternalId)">
                                            <i class="ki-outline fs-4 m-0 ki-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                        <div class="notice d-flex bg-light-success rounded border-success border border-dashed mb-0 p-6">
                            <div class="d-flex flex-stack flex-grow-1">
                                <div class=" fw-semibold">
                                    <div class="fs-6 text-gray-700 ">
                                        <span class="fw-bold cursor-pointer text-success" @onclick="async () => await AddExtraItemAsync()">Adicionar item</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <_ErrorOperation Msg="@(_errorOperation)"/>
                    </div>
                    <div class="text-center">
                        <button type="button" class="btn btn-light me-3" @onclick="async () => await CloseAsync()">Fechar</button>
                        @if (_isLoading)
                        {
                            <_LoadingButton Class="btn-success"/>
                        }
                        else
                        {
                            <button type="button" class="btn btn-success" @onclick="async () => await SaveAsync()">
                                <span class="indicator-label">Salvar complemento</span>
                            </button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@code
{

    [Parameter]
    public EventCallback<ProductExtraModel> OnSave { get; set; }

    [Parameter]
    public ProductExtraModel? ProductExtraEdit { get; set; }

    private List<ProductExtraItemModel> _extraItems = new();

    private string? _name;
    private int _min = 0;
    private int _max = 1;
    private bool _isRequired;

    private bool _isLoading;
    private string? _errorOperation;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("InputMask.Money");
            StateHasChanged();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ProductExtraEdit != null)
        {
            _name = ProductExtraEdit.Name;
            _min = ProductExtraEdit.Min;
            _max = ProductExtraEdit.Max;
            _isRequired = ProductExtraEdit.IsRequired;
            _extraItems = ProductExtraEdit.Items;
            await JsRuntime.InvokeVoidAsync("InputMask.Money");
        }
        else
            Clean();
    }

    async Task AddExtraItemAsync()
    {
        _extraItems.Add(new ProductExtraItemModel());
        await JsRuntime.InvokeVoidAsync("InputMask.Money");
        await JsRuntime.InvokeVoidAsync("InputMask.Money");
        StateHasChanged();
    }

    async Task SaveAsync()
    {
        _errorOperation = null;
        _isLoading = true;

        await Task.Delay(TimeSpan.FromSeconds(0.5));

        var extra = new ProductExtraModel
        {
            Id = ProductExtraEdit?.Id ?? 0,
            Name = _name ?? string.Empty,
            Min = _min,
            Max = _max,
            IsRequired = _isRequired,
            Items = _extraItems
        };

        HttpMethod httpMethod = extra.Id > 0 ? HttpMethod.Put : HttpMethod.Post;

        ApiResponse response = await DataRequest.SendAsync(httpMethod, "/productextra", extra);
        _isLoading = false;

        if (!response.IsSuccessRequest)
        {
            _errorOperation = response.Error;
            return;
        }

        var productExtraResponse = JsonConvert.DeserializeObject<ProductExtraModel>(response.Json ?? string.Empty);

        await CloseAsync();
        Clean();
        await OnSave.InvokeAsync(productExtraResponse);
    }

    async Task CloseAsync() => await JsRuntime.InvokeVoidAsync("Modal.Close", "new_product_extra_modal");

    void ChangeExtraRequired(bool isRequired)
    {
        _isRequired = isRequired;
        _min = _isRequired ? 1 : 0;
    }

    void Clean()
    {
        _name = null;
        _min = 0;
        _max = 1;
        _isRequired = false;
        _extraItems = new List<ProductExtraItemModel>();
    }

    void RemoveExtraItem(Guid internalId) => _extraItems = _extraItems.FindAll(x => x.InternalId != internalId);
}