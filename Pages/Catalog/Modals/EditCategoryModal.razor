@inject DataRequest DataRequest
@inject IJSRuntime JsRuntime

<div class="modal fade" id="modal_edit_category" data-bs-backdrop="static" tabindex="-1" role="dialog" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered mw-650px">
        <div class="modal-content">
            <div class="modal-header pb-0 border-0 justify-content-end">
                <div class="btn btn-sm btn-icon btn-active-color-primary" data-bs-dismiss="modal">
                    <i class="ki-outline ki-cross fs-1"></i>
                </div>
            </div>
            @if (Category != null)
            {
                <div class="modal-body scroll-y mx-5 pt-0">
                <div class="mb-10 text-center">
                    <h1 class="mb-3">Cadastrar categoria</h1>
                    <div class="text-gray-600 fw-semibold fs-5">Categorias são usadas para agrupar produtos que são similares em termos de suas características.</div>
                </div>
                <div class="form">
                    <div class="fv-row mb-7 form-floating">
                        <input class="form-control form-control-solid" placeholder="" maxlength="45" name="categoryName" autocomplete="off" @bind="@(Category.Name)" @onkeyup="async (e) => await EnterKeyPressAsync(e.Key)"/>
                        <label class="required">Nome</label>
                    </div>
                    <div class="fv-row mb-7 form-floating">
                        <input class="form-control form-control-solid" placeholder="" maxlength="250" name="categoryDescription" autocomplete="off" @bind="@(Category.Description)" @onkeyup="async (e) => await EnterKeyPressAsync(e.Key)"/>
                        <label>Descrição</label>
                    </div>
                    <div class="text-gray-600"></div>
                    <div class="text-center pt-5">
                        <button type="button" class="btn btn-light me-3" @onclick="async () => await CloseAsync()">
                            Cancelar
                        </button>
                        @if (_loading)
                        {
                            <button type="button" class="btn btn-success">
                                Salvando <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-success" @onclick="async () => await SaveAsync()">
                                Salvar categoria
                            </button>
                        }
                    </div>
                </div>
            </div>
            }
        </div>
    </div>
</div>

@code
{
    [Parameter]
    public EventCallback<bool> OnSave { get; set; }

    [Parameter]
    public CategoryModel? Category { get; set; }
    
    private bool _loading;
    private string? _currentMsg;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JsRuntime.InvokeVoidAsync("OnModalShow.Focus", "modal_edit_category", "categoryName");
        }
    }

    async Task SaveAsync()
    {
        _currentMsg = null;
        _loading = true;

        await Task.Delay(TimeSpan.FromSeconds(0.2));
        ApiResponse response = await DataRequest.SendAsync(HttpMethod.Put, "/category", Category);
        _loading = false;
        if (response.IsSuccessRequest)
        {
            await JsRuntime.InvokeVoidAsync("Toastr.Success", "Categoria criada com sucesso");
        }
        else
        {
            await JsRuntime.InvokeVoidAsync("Toastr.Warning", response.Error);
            return;
        }

        await CloseAsync();
        await OnSave.InvokeAsync(true);
    }

    async Task CloseAsync() => await JsRuntime.InvokeVoidAsync("Modal.Close", "modal_edit_category");

    async Task EnterKeyPressAsync(string keyPress)
    {
        if (keyPress == "Enter")
            await SaveAsync();
    }
}