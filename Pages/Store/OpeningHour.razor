<ScheduledBreakModal OnSaved="NewScheduledBreak"/>

@code
{
    private List<OpeningHourModel>? _openingHourModel;
    private List<ScheduledBreakModel>? _scheduledBreakModel;
    private bool _loading;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadOpeningHourAsync();
            await LoadScheduledBreakAsync();
        }
    }

    async Task LoadOpeningHourAsync()
    {
        ApiResponse response = await DataRequest.SendAsync(HttpMethod.Get, "/OpeningHour");
        if (response.IsSuccessRequest)
        {
            _openingHourModel = JsonConvert.DeserializeObject<List<OpeningHourModel>>(response.Json ?? string.Empty);
            StateHasChanged();
        }
        else
        {
            await JsRuntime.InvokeVoidAsync("Toastr.Error", response.Error);
        }
    }

    async Task LoadScheduledBreakAsync()
    {
        ApiResponse response = await DataRequest.SendAsync(HttpMethod.Get, "/ScheduledBreak");
        if (response.IsSuccessRequest)
        {
            _scheduledBreakModel = JsonConvert.DeserializeObject<List<ScheduledBreakModel>>(response.Json ?? string.Empty);
            StateHasChanged();
        }
        else
        {
            await JsRuntime.InvokeVoidAsync("Toastr.Error", response.Error);
        }
    }

    async Task SaveAsync()
    {
        _loading = true;
        await Task.Delay(TimeSpan.FromSeconds(0.5));
        ApiResponse response = await DataRequest.SendAsync(HttpMethod.Post, "/OpeningHour", new
        {
            Items = _openingHourModel
        });
        _loading = false;
        if (!response.IsSuccessRequest)
        {
            await JsRuntime.InvokeVoidAsync("Toastr.Error", response.Error);
            return;
        }

        ApiResponse response2 = await DataRequest.SendAsync(HttpMethod.Post, "/ScheduledBreak", new
        {
            Items = _scheduledBreakModel
        });
        _loading = false;
        if (!response2.IsSuccessRequest)
        {
            await JsRuntime.InvokeVoidAsync("Toastr.Error", response2.Error);
            return;
        }

        await JsRuntime.InvokeVoidAsync("Toastr.Success", "horários alterados com sucesso.");
        NavigationManager.NavigateTo("/opening-hour");
    }

    async Task NewOpeningHourAsync()
    {
        if (_openingHourModel == null)
            return;

        var dayOfWeek = await JsRuntime.InvokeAsync<string>("ElementInvoke.Text", ".nav-availability .nav-item a.active");

        if (_openingHourModel.Count(x => x.DayOfWeek == dayOfWeek) > 1)
        {
            await JsRuntime.InvokeVoidAsync("Toastr.Error", "Você só pode adicionar dois intervalos de horários por dia.");
            return;
        }

        _openingHourModel.Add(new OpeningHourModel
        {
            DayOfWeek = dayOfWeek,
            Sort = _openingHourModel.Count(x => x.DayOfWeek == dayOfWeek) + 1,
            BeginAt = "17:00",
            EndAt = "22:00"
        });
        StateHasChanged();
    }

    async Task OpenScheduleBreakAsync()
    {
        await JsRuntime.InvokeVoidAsync("Modal.Show", "scheduled_break_modal");
        StateHasChanged();
    }

    void NewScheduledBreak(ScheduledBreakModel? scheduledBreak)
    {
        if (_scheduledBreakModel == null || scheduledBreak == null)
            return;

        _scheduledBreakModel.Add(scheduledBreak);

        StateHasChanged();
    }

    void Remove(Guid internalId)
    {
        if (_openingHourModel == null)
            return;

        OpeningHourModel? openingHourItem = _openingHourModel.FirstOrDefault(x => x.InternalId == internalId);
        if (openingHourItem == null)
            return;

        _openingHourModel = _openingHourModel.FindAll(x => x.InternalId != openingHourItem.InternalId);

        var sort = 1;

        foreach (OpeningHourModel item in  _openingHourModel.Where(x => x.DayOfWeek == openingHourItem.DayOfWeek).OrderBy(x => x.Sort))
        {
            item.Sort = sort;
            sort++;
        }

        StateHasChanged();
    }
}