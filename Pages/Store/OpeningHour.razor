@page "/opening-hour"

@attribute [Authorize]

@inject NavigationManager NavigationManager
@inject DataRequest DataRequest
@inject IJSRuntime JsRuntime

<div class="d-flex flex-column flex-column-fluid">
<div id="kt_app_toolbar" class="app-toolbar mt-8">
    <div id="kt_app_toolbar_container" class="app-container container-xxl d-flex flex-stack">
        <div class="page-title d-flex flex-column justify-content-center me-3 ">
            <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">
                Horários
            </h1>
            <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-6 my-0 pt-1">
                <li class="breadcrumb-item text-muted">
                    <a class="text-muted text-hover-success">
                        Escolha os dias e horários que sua loja receberá pedidos
                    </a>
                </li>
            </ul>
        </div>

    </div>
</div>
<div id="kt_app_content" class="app-content flex-column-fluid py-3 mt-5">
<div id="kt_app_content_container" class="app-container container-xxl">
<div class="card mb-10">
<div class="card-header card-header-stretch pb-0">
    <div class="card-title">
        <h3 class="m-0">Horário de funcionamento</h3>
    </div>
</div>
<div class="card-body pb-0">
<ul class="nav nav-pills nav-availability d-flex flex-nowrap hover-scroll-x py-0 text-success" role="tablist">
    <li class="nav-item me-1" role="presentation">
        <a title="@(DayOfWeek.Monday.ToString())" class="nav-link btn d-flex flex-column flex-center rounded-pill min-w-45px me-2 py-4 px-3 btn-active-success active" data-bs-toggle="tab" href="#kt_opening_day_mon" aria-selected="false" tabindex="-1" role="tab">
            <span class="fs-6 fw-semibold">Segunda</span>
        </a>
    </li>
    <li class="nav-item me-1" role="presentation">
        <a title="@(DayOfWeek.Tuesday.ToString())" class="nav-link btn d-flex flex-column flex-center rounded-pill min-w-45px me-2 py-4 px-3 btn-active-success" data-bs-toggle="tab" href="#kt_opening_day_tue" aria-selected="false" role="tab" tabindex="-1">
            <span class="fs-6 fw-semibold">Terça</span>
        </a>
    </li>
    <li class="nav-item me-1" role="presentation">
        <a title="@(DayOfWeek.Wednesday.ToString())" class="nav-link btn d-flex flex-column flex-center rounded-pill min-w-45px me-2 py-4 px-3 btn-active-success" data-bs-toggle="tab" href="#kt_opening_day_wed" aria-selected="true" role="tab">
            <span class="fs-6 fw-semibold">Quarta</span>
        </a>
    </li>
    <li class="nav-item me-1" role="presentation">
        <a title="@(DayOfWeek.Thursday.ToString())" class="nav-link btn d-flex flex-column flex-center rounded-pill min-w-45px me-2 py-4 px-3 btn-active-success" data-bs-toggle="tab" href="#kt_opening_day_thu" aria-selected="false" role="tab" tabindex="-1">
            <span class="fs-6 fw-semibold">Quinta</span>
        </a>
    </li>
    <li class="nav-item me-1" role="presentation">
        <a title="@(DayOfWeek.Friday.ToString())" class="nav-link btn d-flex flex-column flex-center rounded-pill min-w-45px me-2 py-4 px-3 btn-active-success" data-bs-toggle="tab" href="#kt_opening_day_fri" aria-selected="false" tabindex="-1" role="tab">
            <span class="fs-6 fw-semibold">Sexta</span>
        </a>
    </li>
    <li class="nav-item me-1" role="presentation">
        <a title="@(DayOfWeek.Saturday.ToString())" class="nav-link btn d-flex flex-column flex-center rounded-pill min-w-45px me-2 py-4 px-3 btn-active-success" data-bs-toggle="tab" href="#kt_opening_day_sat" aria-selected="false" tabindex="-1" role="tab">
