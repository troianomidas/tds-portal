@code
{
    [Parameter]
    public EventCallback<ScheduledBreakModel?> OnSaved { get; set; }

    private string? _title;
    private DateTime? _startAt;
    private string? _startHourAt;
    private DateTime? _endAt;
    private string? _endHourAt;

    private string? _errorMsg;
    private string? _errorField;
    private bool _loading;

    async Task SaveAsync()
    {
        _errorMsg = null;
        _errorField = null;

        _loading = true;
        await Task.Delay(TimeSpan.FromSeconds(0.5));
        _loading = false;
        
        if (string.IsNullOrEmpty(_title))
        {
            await JsRuntime.InvokeVoidAsync("Toastr.Error", "Informe um título para a pausa programada");
            return;
        }

        if (_startAt == null || _endAt == null)
        {
            await JsRuntime.InvokeVoidAsync("Toastr.Error", "Informe a data de início e fim");
            return;
        }
        
        if (_startHourAt == null || _endHourAt == null)
        {
            await JsRuntime.InvokeVoidAsync("Toastr.Error", "Informe o horário de início e fim");
            return;
        }

        var item = new ScheduledBreakModel
        {
            Title = _title,
            StartAt = DateTime.Parse($"{_startAt.Value.ToShortDateString()} {_startHourAt}"),
            EndAt = DateTime.Parse($"{_endAt.Value.ToShortDateString()} {_endHourAt}"),
        };

        if (item.StartAt.Date < DateTime.Now.Date)
        {
            await JsRuntime.InvokeVoidAsync("Toastr.Error", "Início da pausa programada não pode ser menor que hoje");
            return;
        }
        
        if (item.EndAt <= item.StartAt)
        {
            await JsRuntime.InvokeVoidAsync("Toastr.Error", "Início da pausa programada precisa ser menor que o fim");
            return;
        }

        await OnSaved.InvokeAsync(item);

        await CloseAsync();
    }

    async Task CloseAsync() => await JsRuntime.InvokeVoidAsync("Modal.Close", "scheduled_break_modal");
}