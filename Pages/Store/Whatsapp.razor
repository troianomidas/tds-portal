@* *@
@*     protected override async Task OnAfterRenderAsync(bool firstRender) *@
@*     { *@
@*         if (firstRender) *@
@*         { *@
@*             await LoadSettingsAsync(); *@
@*         } *@
@*     } *@
@* *@
@*     async Task SaveAsync() *@
@*     { *@
@*         _loading = true; *@
@*         await Task.Delay(TimeSpan.FromSeconds(0.5)); *@
@*         ApiResponse response = await DataRequest.SendAsync(HttpMethod.Put, "/store/settings", _settings); *@
@*         _loading = false; *@
@*         if (!response.IsSuccessRequest) *@
@*         { *@
@*             await JsRuntime.InvokeVoidAsync("Toastr.Error", response.Error); *@
